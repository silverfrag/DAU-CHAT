<UserControl x:Class="DauChat.Client.UI.Views.ChatWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1200">

    <UserControl.Resources>
        <Style x:Key="MsgMiniActionBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Background" Value="{StaticResource SurfaceWhiteBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBd" Property="Background" Value="{StaticResource DauRedSoftBrush}" />
                                <Setter TargetName="BtnBd" Property="BorderBrush" Value="{StaticResource DauRedBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="MessageContextMenu" x:Shared="False">
            <MenuItem Header="Trả lời tin nhắn này"
                      Command="{Binding PlacementTarget.Tag.ReplyToMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding PlacementTarget.DataContext.CanReplyThisMessage, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
            <MenuItem Header="Sao chép nội dung"
                      Command="{Binding PlacementTarget.Tag.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding PlacementTarget.DataContext.CanCopyThisMessage, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
            <MenuItem Header="Ghim lên đầu phòng"
                      Command="{Binding PlacementTarget.Tag.PinMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding PlacementTarget.DataContext.CanPinThisMessage, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
            <Separator Visibility="{Binding PlacementTarget.DataContext.ShowContextActionSeparator, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
            <MenuItem Header="Thu hồi với mọi người"
                      Foreground="#B45309"
                      FontWeight="SemiBold"
                      Command="{Binding PlacementTarget.Tag.RecallMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding PlacementTarget.DataContext.CanRecallThisMessage, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
            <MenuItem Header="Xóa ở phía tôi"
                      Foreground="#DC2626"
                      Command="{Binding PlacementTarget.Tag.DeleteSingleMessageLocalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding PlacementTarget.DataContext.CanDeleteForMe, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- CỘT 1: DANH SÁCH HỘI THOẠI / PHÒNG HỌC -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceWhiteBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header danh sách -->
                <StackPanel Grid.Row="0" Margin="20,20,20,14">
                    <Grid Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="DAU CONNECT"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource DauRedTextBrush}" />
                            <TextBlock Text="{Binding SidebarHeading}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    MinHeight="36"
                                    Padding="11,5"
                                    Margin="0,0,8,0"
                                    BorderBrush="{StaticResource DauRedBorderBrush}"
                                    Background="{StaticResource DauRedSoftBrush}"
                                    Foreground="{StaticResource DauRedTextBrush}"
                                    Visibility="{Binding CanJoinByCode, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding OpenJoinByCodeCommand}"
                                    ToolTip="Tham gia lớp học hoặc nhóm học tập bằng mã">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconHash}"
                                          Stroke="{StaticResource DauRedTextBrush}"
                                          StrokeThickness="2.2"
                                          Width="12" Height="12" Stretch="Uniform"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Mã lớp" Margin="5,0,0,0" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource DauRedTextBrush}" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource BrandSquareIconButtonStyle}"
                                    Visibility="{Binding CanCreateRoom, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding OpenCreateRoomCommand}"
                                    ToolTip="{Binding CreateRoomTooltip}">
                                <Path Data="{StaticResource IconPlus}"
                                      Stroke="White"
                                      StrokeThickness="2.2"
                                      Width="18" Height="18" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Thanh tìm kiếm hội thoại -->
                    <Border Background="{StaticResource SurfaceInputBrush}"
                            CornerRadius="12"
                            Padding="12,0"
                            Height="42">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Data="{StaticResource IconSearch}"
                                  Stroke="{StaticResource TextFaintBrush}"
                                  StrokeThickness="2"
                                  Width="16" Height="16" Stretch="Uniform"
                                  VerticalAlignment="Center" />
                            <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Tìm người, phòng hoặc nội dung..."
                                           FontSize="12.5"
                                           Foreground="{StaticResource TextFaintBrush}"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding SearchQuery, Converter={StaticResource InverseStringToVis}}" />
                                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="13"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         CaretBrush="{StaticResource DauRedBrush}"
                                         VerticalContentAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Bộ lọc Gần đây / Chưa đọc -->
                <Grid Grid.Row="1" Margin="20,0,20,8">
                    <TextBlock Text="{Binding ListCountSummary}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right"
                            Command="{Binding ToggleFilterUnreadCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Padding="4,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FilterButtonLabel}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource DauRedTextBrush}" />
                            <Path Data="{StaticResource IconChevronDown}"
                                  Stroke="{StaticResource DauRedTextBrush}"
                                  StrokeThickness="2"
                                  Width="11" Height="11" Stretch="Uniform"
                                  Margin="4,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Danh sách hội thoại -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="8,0,8,12">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding FilteredConversations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,0,4"
                                            Command="{Binding DataContext.SelectConversationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="RowBg"
                                                        CornerRadius="14"
                                                        Padding="12,11"
                                                        Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="RowBg" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="RowBg" Property="Background" Value="{StaticResource DauRedSoftBrush}" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Avatar + chấm Online -->
                                            <Grid Grid.Column="0" Width="44" Height="44" Margin="0,0,12,0">
                                                <Border CornerRadius="14"
                                                        Background="{Binding AvatarBgHex, Converter={StaticResource HexToBrush}}">
                                                    <TextBlock Text="{Binding Initials}"
                                                               FontSize="12.5"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding AvatarFgHex, Converter={StaticResource HexToBrush}}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <Ellipse Width="12" Height="12"
                                                         Fill="{StaticResource EmeraldBrush}"
                                                         Stroke="White"
                                                         StrokeThickness="2.5"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Bottom"
                                                         Margin="0,0,-2,-2"
                                                         Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}" />
                                            </Grid>

                                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" Margin="0,0,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Title}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource DauRedSelectedTextBrush}" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <Path Data="{StaticResource IconBellOff}"
                                                              Stroke="{StaticResource TextFaintBrush}"
                                                              StrokeThickness="1.9"
                                                              Width="11" Height="11" Stretch="Uniform"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,5,0"
                                                              ToolTip="Đã tắt thông báo"
                                                              Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding TimeLabel}"
                                                                   FontSize="10.5"
                                                                   Foreground="{StaticResource TextFaintBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Subtitle}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Border Grid.Column="1"
                                                            Margin="8,0,0,0"
                                                            MinWidth="20"
                                                            Height="20"
                                                            Padding="6,0"
                                                            CornerRadius="10"
                                                            Background="{StaticResource DauRedBrush}"
                                                            Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding UnreadCount}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty Search State -->
                        <StackPanel Margin="20,48"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding FilteredConversations.Count, Converter={StaticResource ZeroToVis}}">
                            <Path Data="{StaticResource IconSearch}"
                                  Stroke="{StaticResource BorderStrongBrush}"
                                  StrokeThickness="1.8"
                                  Width="26" Height="26" Stretch="Uniform"
                                  HorizontalAlignment="Center" />
                            <TextBlock Text="Không tìm thấy kết quả"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0" />
                            <TextBlock Text="Thử từ khóa tên phòng hoặc giảng viên khác"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextFaintBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Thẻ trạng thái Local-First -->
                <Border Grid.Row="3"
                        Margin="16,0,16,16"
                        Background="{StaticResource SurfaceSubtleBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource EmeraldBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Local-first đang hoạt động"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                            <Path HorizontalAlignment="Right"
                                  Data="{StaticResource IconShieldCheck}"
                                  Stroke="{StaticResource EmeraldTextBrush}"
                                  StrokeThickness="2"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </Grid>
                        <TextBlock Text="Tin nhắn &amp; tệp được lưu riêng trên máy trạm (.jsonl + SHA-256)."
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- CỘT 2: KHÔNG GIAN CHAT CHÍNH -->
        <Grid x:Name="ChatColumnGrid"
              Grid.Column="1"
              Background="{StaticResource CanvasBgBrush}"
              AllowDrop="True"
              PreviewDragOver="ChatArea_PreviewDragOver"
              PreviewDragLeave="ChatArea_PreviewDragLeave"
              PreviewDrop="ChatArea_PreviewDrop">
            <Grid.RowDefinitions>
                <RowDefinition Height="74" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Chat Header (Không có Call/Video thừa thãi) -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceWhiteBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="42" Height="42" Margin="0,0,12,0">
                        <Border CornerRadius="13"
                                Background="{Binding SelectedConversation.AvatarBgHex, Converter={StaticResource HexToBrush}, FallbackValue={StaticResource DauRedSoftBrush}}">
                            <TextBlock Text="{Binding SelectedConversation.Initials, FallbackValue='LT'}"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="{Binding SelectedConversation.AvatarFgHex, Converter={StaticResource HexToBrush}, FallbackValue={StaticResource DauRedTextBrush}}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Ellipse Width="11" Height="11"
                                 Fill="{StaticResource EmeraldBrush}"
                                 Stroke="White"
                                 StrokeThickness="2"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,-2,-2"
                                 Visibility="{Binding SelectedConversation.IsOnline, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding SelectedConversation.Title, FallbackValue='Chưa chọn cuộc trò chuyện'}"
                                   FontSize="14.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SelectedConversation.MetaCaption}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="32"
                                Padding="10,4"
                                Background="{StaticResource SurfaceSubtleBrush}"
                                Visibility="{Binding SelectedConversation.HasJoinCode, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                Command="{Binding CopyRoomJoinCodeCommand}"
                                ToolTip="Sao chép mã lớp / phòng">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCopy}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.9" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedConversation.RoomJoinCode}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource DauRedTextBrush}"
                                           Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,4,0"
                                Style="{StaticResource IconButtonStyle}"
                                Visibility="{Binding CanEditOrDeleteSelectedRoom, Converter={StaticResource BoolToVis}}"
                                Command="{Binding OpenEditRoomCommand}"
                                ToolTip="Chỉnh sửa tên &amp; mô tả phòng">
                            <Path Data="{StaticResource IconEdit}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.9"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding ToggleMessageSearchCommand}"
                                ToolTip="Tìm kiếm trong hội thoại">
                            <Path Data="{StaticResource IconSearch}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.9"
                                  Width="18" Height="18" Stretch="Uniform" />
                        </Button>
                        <Button Margin="4,0,0,0"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding ToggleInfoDrawerCommand}"
                                ToolTip="Thông tin phòng &amp; Tệp chia sẻ">
                            <Path Data="{StaticResource IconInfo}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.9"
                                  Width="18" Height="18" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Thanh tìm kiếm trong hội thoại -->
            <Border Grid.Row="1"
                    Visibility="{Binding ShowMessageSearch, Converter={StaticResource BoolToVis}}"
                    Background="{StaticResource SurfaceWhiteBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,10">
                <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="10" Padding="12,6" MaxWidth="680">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconSearch}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Margin="10,0"
                                 Text="{Binding MessageSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="12.5" />
                        <Button Grid.Column="2"
                                Content="Đóng"
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DauRedTextBrush}"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding ToggleMessageSearchCommand}" />
                    </Grid>
                </Border>
            </Border>

            <!-- Thông báo đã ghim của Giảng viên -->
            <Border Grid.Row="2"
                    Visibility="{Binding HasPinnedNotice, Converter={StaticResource BoolToVis}}"
                    Margin="20,14,20,0"
                    Background="{StaticResource SurfaceWhiteBrush}"
                    BorderBrush="{StaticResource DauRedBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="34" Height="34"
                            CornerRadius="10"
                            Background="{StaticResource DauRedSoftBrush}"
                            Margin="0,0,12,0">
                        <Path Data="{StaticResource IconPin}"
                              Stroke="{StaticResource DauRedTextBrush}"
                              StrokeThickness="2"
                              Width="16" Height="16" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="THÔNG BÁO ĐÃ GHIM"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource DauRedTextBrush}" />
                            <TextBlock Text="{Binding PinnedNoticeAuthor, StringFormat=' • {0}'}"
                                       FontSize="10.5"
                                       Foreground="{StaticResource TextFaintBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding PinnedNoticeContent}"
                                   FontSize="12.5"
                                   Foreground="{StaticResource TextBodyBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="{Binding CanPinThisRoom, Converter={StaticResource BoolToVis}}">
                        <Button Content="Sửa"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="30"
                                Padding="10,4"
                                FontSize="11"
                                Command="{Binding EditPinNoticeCommand}" />
                        <Button Margin="6,0,0,0"
                                Width="30" Height="30"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding UnpinNoticeCommand}"
                                ToolTip="Bỏ ghim thông báo">
                            <Path Data="{StaticResource IconClose}"
                                  Stroke="{StaticResource TextMutedBrush}"
                                  StrokeThickness="2"
                                  Width="13" Height="13" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Danh sách tin nhắn + Floating Jump-to-Latest Pill -->
            <Grid Grid.Row="3">
                <ScrollViewer x:Name="MessagesScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              Padding="22,16"
                              ScrollChanged="MessagesScrollViewer_ScrollChanged">
                    <StackPanel MaxWidth="780">
                        <Border HorizontalAlignment="Center"
