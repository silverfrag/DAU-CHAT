                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Thẻ tệp thường -->
                                                    <Border Width="360"
                                                            Background="{StaticResource SurfaceWhiteBrush}"
                                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="16"
                                                            Padding="12"
                                                            Visibility="{Binding IsFileCardWithoutPreview, Converter={StaticResource BoolToVis}}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0"
                                                                    Width="44" Height="44"
                                                                    CornerRadius="12"
                                                                    Background="{Binding AttachmentBadgeBgHex, Converter={StaticResource HexToBrush}}">
                                                                <TextBlock Text="{Binding AttachmentBadgeText}"
                                                                           FontSize="11"
                                                                           FontWeight="Bold"
                                                                           Foreground="{Binding AttachmentBadgeFgHex, Converter={StaticResource HexToBrush}}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding AttachmentFileName}"
                                                                           FontSize="12.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding AttachmentSizeText}"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           Margin="0,3,0,0" />
                                                            </StackPanel>
                                                            <Button Grid.Column="2"
                                                                    Style="{StaticResource IconButtonStyle}"
                                                                    Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="Mở tệp Local">
                                                                <Path Data="{StaticResource IconDownload}"
                                                                      Stroke="{StaticResource TextSecondaryBrush}"
                                                                      StrokeThickness="2"
                                                                      Width="16" Height="16" Stretch="Uniform" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,2,0">
                                                    <TextBlock Text="{Binding TimeText}" FontSize="10.5" Foreground="{StaticResource TextFaintBrush}" />
                                                    <TextBlock Text=" • SHA-256 ✓" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource EmeraldTextBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 6. Tin nhắn đã thu hồi đến -->
                                        <Grid x:Name="IncomingRecalledRow"
                                              Background="Transparent"
                                              Visibility="{Binding IsIncomingRecalled, Converter={StaticResource BoolToVis}}"
                                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              ContextMenu="{StaticResource MessageContextMenu}"
                                              ContextMenuOpening="MessageRow_ContextMenuOpening">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Grid MaxWidth="520">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                                            Width="34" Height="34"
                                                            CornerRadius="11"
                                                            VerticalAlignment="Top"
                                                            Margin="0,0,10,0"
                                                            Opacity="0.72"
                                                            Background="{Binding AvatarBgHex, Converter={StaticResource HexToBrush}}">
                                                        <TextBlock Text="{Binding SenderInitials}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding AvatarFgHex, Converter={StaticResource HexToBrush}}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                            <TextBlock Text="{Binding SenderName}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextMutedBrush}" />
                                                            <Border Margin="8,0,0,0"
                                                                    CornerRadius="5"
                                                                    Padding="6,1"
                                                                    Background="{StaticResource SurfaceInputBrush}"
                                                                    Visibility="{Binding HasRoleBadge, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding SenderRoleLabel}"
                                                                           FontSize="9.5"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource TextMutedBrush}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding TimeText}"
                                                                       FontSize="10.5"
                                                                       Foreground="{StaticResource TextFaintBrush}"
                                                                       Margin="8,0,0,0"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <Border Background="#F8FAFC"
                                                                BorderBrush="{StaticResource BorderStrongBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6,16,16,16"
                                                                Padding="13,9">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="{StaticResource IconRecall}"
                                                                      Stroke="{StaticResource TextFaintBrush}"
                                                                      StrokeThickness="1.8"
                                                                      Width="13" Height="13" Stretch="Uniform"
                                                                      VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding BodyContent}"
                                                                           FontSize="12.5"
                                                                           FontStyle="Italic"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           Margin="7,0,0,0"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel x:Name="IncomingRecalledActions"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            Margin="8,18,0,0"
                                                            Visibility="Hidden">
                                                    <Button Style="{StaticResource MsgMiniActionBtnStyle}"
                                                            ToolTip="Xóa ở phía tôi (chỉ ẩn trên máy này)"
                                                            Visibility="{Binding CanDeleteForMe, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.DeleteSingleMessageLocalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Path Data="{StaticResource IconTrash}" Stroke="{StaticResource DangerTextBrush}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" />
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 7. Tin nhắn đã thu hồi gửi đi -->
                                        <Grid x:Name="OutgoingRecalledRow"
                                              Background="Transparent"
                                              Visibility="{Binding IsOutgoingRecalled, Converter={StaticResource BoolToVis}}"
                                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              ContextMenu="{StaticResource MessageContextMenu}"
                                              ContextMenuOpening="MessageRow_ContextMenuOpening">
                                            <StackPanel HorizontalAlignment="Right">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <StackPanel x:Name="OutgoingRecalledActions"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,8,0"
                                                                Visibility="Hidden">
                                                        <Button Style="{StaticResource MsgMiniActionBtnStyle}"
                                                                ToolTip="Xóa ở phía tôi (chỉ ẩn trên máy này)"
                                                                Visibility="{Binding CanDeleteForMe, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.DeleteSingleMessageLocalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Path Data="{StaticResource IconTrash}" Stroke="{StaticResource DangerTextBrush}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" />
                                                        </Button>
                                                    </StackPanel>

                                                    <Border Background="#F1F5F9"
                                                            BorderBrush="{StaticResource BorderStrongBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="16,6,16,16"
                                                            Padding="13,9"
                                                            MaxWidth="500">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconRecall}"
                                                                  Stroke="{StaticResource TextMutedBrush}"
                                                                  StrokeThickness="1.8"
                                                                  Width="13" Height="13" Stretch="Uniform"
                                                                  VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding BodyContent}"
                                                                       FontSize="12.5"
                                                                       FontStyle="Italic"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       Margin="7,0,0,0"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,2,0">
                                                    <TextBlock Text="{Binding TimeText}" FontSize="10.5" Foreground="{StaticResource TextFaintBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="IncomingTextRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="IncomingTextActions" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger SourceName="OutgoingTextRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="OutgoingTextActions" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger SourceName="IncomingAttachRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="IncomingAttachActions" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger SourceName="OutgoingAttachRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="OutgoingAttachActions" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger SourceName="IncomingRecalledRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="IncomingRecalledActions" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger SourceName="OutgoingRecalledRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="OutgoingRecalledActions" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Floating "Tin nhắn mới" pill khi người dùng đang cuộn đọc lịch sử cũ -->
                <Button HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,14"
                        Panel.ZIndex="10"
                        Cursor="Hand"
                        BorderThickness="0"
                        Background="Transparent"
                        Command="{Binding JumpToLatestCommand}"
                        Visibility="{Binding HasUnseenScrollMessages, Converter={StaticResource BoolToVis}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="PillBg"
                                    Background="{StaticResource DauRedBrush}"
                                    CornerRadius="18"
                                    Padding="14,7">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.22" Color="#0F172A" />
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconArrowDown}" Stroke="White" StrokeThickness="2.2" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding UnseenScrollPillText}" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="6,0,0,0" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PillBg" Property="Background" Value="{StaticResource DauRedHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Tiến trình Chunked Streaming đang chạy -->
            <ItemsControl Grid.Row="4" ItemsSource="{Binding ActiveTransfers}" Margin="22,0,22,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border MaxWidth="460"
                                HorizontalAlignment="Right"
                                Background="{StaticResource SurfaceWhiteBrush}"
                                BorderBrush="{StaticResource DauRedBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="12"
                                Margin="0,0,0,6">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding FileName}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock HorizontalAlignment="Right"
                                               Text="{Binding Percentage, StringFormat='{}{0:0}%'}"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource DauRedTextBrush}" />
                                </Grid>
                                <ProgressBar Height="6"
                                             Margin="0,8,0,6"
                                             Maximum="100"
                                             Value="{Binding Percentage}"
                                             Foreground="{StaticResource DauRedBrush}"
                                             Background="{StaticResource SurfaceInputBrush}"
                                             BorderThickness="0" />
                                <TextBlock Text="{Binding StatusText}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Thanh soạn tin nhắn (Text + Reply Preview + Đính kèm nhiều tệp / Ctrl+V) -->
            <Border Grid.Row="5"
                    Background="{StaticResource SurfaceWhiteBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,12"
                    Visibility="{Binding CanSendMessages, Converter={StaticResource BoolToVis}}">
                <StackPanel MaxWidth="780">
                    <Border Visibility="{Binding HasReplyingTo, Converter={StaticResource BoolToVis}}"
                            Background="{StaticResource SurfaceSubtleBrush}"
                            BorderBrush="{StaticResource DauRedBorderBrush}"
                            BorderThickness="3,0,0,0"
                            CornerRadius="8"
                            Padding="12,8"
                            Margin="0,0,0,9">
                        <Grid>
                            <StackPanel Margin="0,0,34,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconReply}" Stroke="{StaticResource DauRedTextBrush}" StrokeThickness="2" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ReplyingToAuthor, StringFormat='Đang trả lời {0}'}"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource DauRedTextBrush}"
                                               Margin="6,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding ReplyingToSnippet}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Width="26" Height="26"
                                    Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding CancelReplyCommand}"
                                    ToolTip="Hủy trả lời (Esc)">
                                <Path Data="{StaticResource IconClose}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2" Width="12" Height="12" Stretch="Uniform" />
                            </Button>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource SurfaceSubtleBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="15"
                                Padding="6,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding AttachFileCommand}"
                                        ToolTip="Đính kèm nhiều tệp / kéo-thả / Ctrl+V dán ảnh (Chunk 64KB + SHA-256)">
                                    <Path Data="{StaticResource IconPaperclip}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.9"
                                          Width="18" Height="18" Stretch="Uniform" />
                                </Button>

                                <Grid Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ComposerPlaceholder}"
                                               FontSize="13"
                                               Foreground="{StaticResource TextFaintBrush}"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding DraftMessage, Converter={StaticResource InverseStringToVis}}" />
                                    <TextBox x:Name="ComposerTextBox"
                                             Text="{Binding DraftMessage, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontSize="13.5"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             CaretBrush="{StaticResource DauRedBrush}"
                                             AcceptsReturn="True"
                                             MaxHeight="96"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             PreviewKeyDown="ComposerTextBox_PreviewKeyDown" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Button Grid.Column="1"
                                Margin="10,0,0,0"
                                Width="46" Height="46"
                                Style="{StaticResource BrandSquareIconButtonStyle}"
                                Command="{Binding SendMessageCommand}"
                                ToolTip="Gửi tin nhắn (Enter)">
                            <Path Data="{StaticResource IconSend}"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  Width="18" Height="18" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Thanh Quản trị phòng chat (Hiển thị riêng cho Admin) -->
            <Border Grid.Row="5"
                    Background="{StaticResource SurfaceWhiteBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,12"
                    Visibility="{Binding IsAdminMode, Converter={StaticResource BoolToVis}}">
                <Grid MaxWidth="820">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource DauRedSoftBrush}">
                            <Path Data="{StaticResource IconShieldCheck}" Stroke="{StaticResource DauRedTextBrush}" StrokeThickness="1.9" Width="15" Height="15" Stretch="Uniform" />
                        </Border>
                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Quản trị Phòng chat" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Quản lý phòng &amp; thành viên" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="33"
                                Padding="9,5"
                                Margin="0,0,6,0"
                                FontSize="12"
                                Content="Sửa phòng"
                                Command="{Binding OpenEditRoomCommand}" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="33"
                                Padding="9,5"
                                Margin="0,0,6,0"
                                FontSize="12"
                                Content="+ Thành viên"
                                Command="{Binding OpenAddMemberCommand}" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="33"
                                Padding="9,5"
                                FontSize="12"
                                Foreground="{StaticResource DangerTextBrush}"
                                Content="Xóa phòng"
                                Command="{Binding DeleteRoomCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Drop Files Overlay khi kéo tệp vào vùng chat -->
            <Grid x:Name="DropFilesOverlay"
                  Grid.Row="0"
                  Grid.RowSpan="6"
                  Panel.ZIndex="20"
                  Background="#E6FFFFFF"
                  IsHitTestVisible="False"
                  Visibility="Collapsed">
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="White"
                        CornerRadius="20"
                        Padding="34,26">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.16" Color="#0F172A" />
                    </Border.Effect>
                    <Grid>
                        <Rectangle Stroke="{StaticResource DauRedBrush}"
                                   StrokeThickness="2"
                                   StrokeDashArray="4 3"
                                   RadiusX="14"
                                   RadiusY="14"
                                   Margin="-14" />
                        <StackPanel HorizontalAlignment="Center" Margin="8,4">
                            <Border Width="54" Height="54" CornerRadius="16" Background="{StaticResource DauRedSoftBrush}" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconUpload}" Stroke="{StaticResource DauRedTextBrush}" StrokeThickness="2" Width="24" Height="24" Stretch="Uniform" />
                            </Border>
                            <TextBlock Text="Thả tệp hoặc ảnh để gửi ngay"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0" />
                            <TextBlock Text="Hỗ trợ kéo nhiều tệp cùng lúc • Truyền luồng 64KB + xác thực SHA-256"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- CỘT 3: DRAWER THÔNG TIN PHÒNG -->
        <Border Grid.Column="2"
                Width="296"
                Visibility="{Binding IsInfoDrawerOpen, Converter={StaticResource BoolToVis}}"
                Background="{StaticResource SurfaceWhiteBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="74" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="18,0">
                    <Grid>
                        <TextBlock Text="{Binding InfoHeaderTitle}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding ToggleInfoDrawerCommand}"
                                ToolTip="Đóng bảng thông tin">
                            <Path Data="{StaticResource IconClose}"
                                  Stroke="{StaticResource TextMutedBrush}"
                                  StrokeThickness="2"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Thông tin tổng quan -->
                        <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="18,16">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="58" Height="58" CornerRadius="17"
                                        Background="{Binding SelectedConversation.AvatarBgHex, Converter={StaticResource HexToBrush}, FallbackValue={StaticResource DauRedSoftBrush}}">
                                    <TextBlock Text="{Binding SelectedConversation.Initials, FallbackValue='LT'}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="{Binding SelectedConversation.AvatarFgHex, Converter={StaticResource HexToBrush}, FallbackValue={StaticResource DauRedTextBrush}}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding SelectedConversation.Title}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0" />
                                <TextBlock Text="{Binding SelectedConversation.MetaCaption}"
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,3,0,0" />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding ToggleMuteCommand}" Margin="4,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="12">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource SurfaceInputBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelectedConversationMuted}" Value="True">
                                                                <Setter Property="Background" Value="#FFF1F1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Path StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Data" Value="{StaticResource IconBell}" />
                                                            <Setter Property="Stroke" Value="{StaticResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelectedConversationMuted}" Value="True">
                                                                    <Setter Property="Data" Value="{StaticResource IconBellOff}" />
                                                                    <Setter Property="Stroke" Value="{StaticResource DauRedTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Border>
                                            <TextBlock Text="{Binding SelectedConversationMuteLabel}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,5,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelectedConversationMuted}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource DauRedTextBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>

                                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding EditPinNoticeCommand}"
                                            Visibility="{Binding CanPinThisRoom, Converter={StaticResource BoolToVis}}"
                                            Margin="4,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource DauRedSoftBrush}">
                                                <Path Data="{StaticResource IconPin}" Stroke="{StaticResource DauRedTextBrush}" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Text="Ghim tin" FontSize="10.5" Foreground="{StaticResource DauRedTextBrush}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Button>

                                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding OpenEditRoomCommand}"
                                            Visibility="{Binding CanEditOrDeleteSelectedRoom, Converter={StaticResource BoolToVis}}"
                                            Margin="4,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource SurfaceInputBrush}">
                                                <Path Data="{StaticResource IconEdit}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Text="Sửa phòng" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Button>

                                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding ToggleMessageSearchCommand}" Margin="4,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource SurfaceInputBrush}">
                                                <Path Data="{StaticResource IconSearch}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Text="Tìm kiếm" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <Button Margin="0,12,0,0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        MinHeight="34"
                                        Padding="12,5"
                                        Background="#FFF8F8"
                                        BorderBrush="{StaticResource DauRedBorderBrush}"
                                        Visibility="{Binding SelectedConversation.HasJoinCode, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                        Command="{Binding CopyRoomJoinCodeCommand}"
                                        ToolTip="Bấm để sao chép mã tham gia lớp / phòng">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Mã tham gia:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding SelectedConversation.RoomJoinCode}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource DauRedTextBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Thành viên phòng -->
                        <Border BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="18,13"
                                Visibility="{Binding SelectedConversation.IsRoom, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="{Binding RoomMembers.Count, StringFormat='Thành viên ({0})'}"
                                               FontSize="12.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                    <Button HorizontalAlignment="Right"
                                            Visibility="{Binding CanManageSelectedRoomMembers, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding OpenAddMemberCommand}"
                                            Background="{StaticResource DauRedSoftBrush}"
                                            BorderThickness="0"
                                            Padding="9,5"
                                            Cursor="Hand"
                                            ToolTip="Thêm thành viên vào phòng">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconUserPlus}" Stroke="{StaticResource DauRedTextBrush}" StrokeThickness="2" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                                                        <TextBlock Text="Thêm" Margin="5,0,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DauRedTextBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding RoomMembers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,10,0">
                                                    <Border CornerRadius="10" Background="{Binding AvatarBgHex, Converter={StaticResource HexToBrush}}">
                                                        <TextBlock Text="{Binding Initials}" FontSize="10" FontWeight="Bold" Foreground="{Binding AvatarFgHex, Converter={StaticResource HexToBrush}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Ellipse Width="9" Height="9"
                                                             Fill="{Binding Presence, Converter={StaticResource PresenceToBrush}}"
                                                             Stroke="White" StrokeThickness="1.5"
                                                             HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FullName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBodyBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Role, Converter={StaticResource RoleDisplay}}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Width="26" Height="26"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Visibility="{Binding CanBeRemoved, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Xóa thành viên khỏi phòng">
                                                    <Path Data="{StaticResource IconUserX}" Stroke="{StaticResource DangerTextBrush}" StrokeThickness="1.8" Width="13" Height="13" Stretch="Uniform" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Tệp đã chia sẻ -->
                        <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="18,13">
                            <StackPanel>
                                <TextBlock Text="Tệp đã chia sẻ" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding RoomSharedFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,0,8"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Margin="0,0,10,0"
                                                            Background="{Binding IconBgHex, Converter={StaticResource HexToBrush}}">
                                                        <Path Data="{StaticResource IconFileText}" Stroke="{Binding IconFgHex, Converter={StaticResource HexToBrush}}" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextBodyBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding SizeAndTimeText}" FontSize="10" Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Chưa có tài liệu chia sẻ trong hội thoại này."
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextFaintBrush}"
                                           Visibility="{Binding RoomSharedFiles.Count, Converter={StaticResource ZeroToVis}}" />
                            </StackPanel>
                        </Border>

                        <!-- Thao tác quản lý Local & Phòng -->
                        <StackPanel Margin="14,10,14,14">
                            <Button Style="{StaticResource DangerGhostButtonStyle}"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Visibility="{Binding CanSendMessages, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DeleteLocalHistoryCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconTrash}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="Xóa lịch sử ở phía tôi" Margin="10,0,0,0" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource DangerGhostButtonStyle}"
                                    Visibility="{Binding CanLeaveSelectedRoom, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding LeaveRoomCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconClose}" Stroke="{StaticResource DangerTextBrush}" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="Rời khỏi phòng" Margin="11,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource DangerTextBrush}" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource DangerGhostButtonStyle}"
                                    Visibility="{Binding CanEditOrDeleteSelectedRoom, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DeleteRoomCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconTrash}" Stroke="{StaticResource DangerTextBrush}" StrokeThickness="1.9" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="Giải tán / Xóa phòng" Margin="11,0,0,0" FontSize="12" FontWeight="Bold" Foreground="{StaticResource DangerTextBrush}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
