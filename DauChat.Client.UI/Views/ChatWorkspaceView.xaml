<UserControl x:Class="DauChat.Client.UI.Views.ChatWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:infra="clr-namespace:DauChat.Client.UI.Infrastructure"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1200">

    <UserControl.Resources>
        <Style x:Key="MsgMiniActionBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="{StaticResource GlassDockBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="MiniScale" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="MiniTrans" X="0" Y="0" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBd" Property="Background" Value="#F5FAFDFF" />
                                <Setter TargetName="BtnBd" Property="BorderBrush" Value="{StaticResource BrandSlateBorderBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="MiniScale" Storyboard.TargetProperty="ScaleX" To="1.12" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="MiniScale" Storyboard.TargetProperty="ScaleY" To="1.12" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="MiniTrans" Storyboard.TargetProperty="Y" To="-1.2" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="MiniScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="MiniScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="MiniTrans" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="MessageContextMenu" x:Shared="False">
            <MenuItem Header="Trả lời tin nhắn này"
                      Command="{Binding PlacementTarget.Tag.ReplyToMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding PlacementTarget.DataContext.CanReplyThisMessage, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
            <MenuItem Header="Sao chép nội dung"
                      Command="{Binding PlacementTarget.Tag.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding PlacementTarget.DataContext.CanCopyThisMessage, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
            <MenuItem Header="Ghim tin nhắn"
                      Command="{Binding PlacementTarget.Tag.PinMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding PlacementTarget.DataContext.CanPinThisMessage, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
            <Separator Visibility="{Binding PlacementTarget.DataContext.ShowContextActionSeparator, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
            <MenuItem Header="Thu hồi tin nhắn"
                      Foreground="#B45309"
                      FontWeight="SemiBold"
                      Command="{Binding PlacementTarget.Tag.RecallMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding PlacementTarget.DataContext.CanRecallThisMessage, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
            <MenuItem Header="Xóa ở phía tôi"
                      Foreground="#DC2626"
                      Command="{Binding PlacementTarget.Tag.DeleteSingleMessageLocalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding PlacementTarget.DataContext.CanDeleteForMe, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28*" MinWidth="288" MaxWidth="350" />
            <ColumnDefinition Width="72*" MinWidth="360" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- CỘT 1: DANH SÁCH HỘI THOẠI / PHÒNG HỌC (TÁCH LỚP BÓNG CACHED GPU — ZERO RE-BLUR) -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Border CornerRadius="24"
                    BorderThickness="3"
                    BorderBrush="#5208131F"
                    Background="Transparent"
                    Effect="{StaticResource GlassPanelShadow}"
                    CacheMode="BitmapCache"
                    IsHitTestVisible="False" />
            <Border Background="{StaticResource GlassPanelBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1.3"
                    CornerRadius="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Ánh sáng kính chéo & viền vát trong 1px -->
                <Border Grid.RowSpan="4" CornerRadius="23" IsHitTestVisible="False" Background="{StaticResource GlassDiagonalSheenBrush}" />
                <Border Grid.RowSpan="4" Margin="1" CornerRadius="22" BorderBrush="{StaticResource GlassInnerRimBrush}" BorderThickness="1" IsHitTestVisible="False" />

                <!-- Header danh sách (Tách cột rõ ràng — tuyệt đối không chồng đè) -->
                <StackPanel Grid.Row="0" Margin="18,20,18,14">
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="DAU CONNECT"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource DauRedTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SidebarHeading}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    MinHeight="34"
                                    Padding="9,5"
                                    Margin="0,0,7,0"
                                    BorderBrush="{StaticResource BrandSlateBorderBrush}"
                                    Background="{StaticResource BrandSlateSoftBrush}"
                                    Foreground="{StaticResource BrandSlateTextBrush}"
                                    Visibility="{Binding CanJoinByCode, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding OpenJoinByCodeCommand}"
                                    ToolTip="Tham gia lớp học hoặc nhóm học tập bằng mã">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconHash}"
                                          Stroke="{StaticResource BrandSlateTextBrush}"
                                          StrokeThickness="2.2"
                                          Width="11" Height="11" Stretch="Uniform"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Mã lớp" Margin="4,0,0,0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandSlateTextBrush}" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource BrandSquareIconButtonStyle}"
                                    Width="36" Height="36"
                                    Visibility="{Binding CanCreateRoom, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding OpenCreateRoomCommand}"
                                    ToolTip="{Binding CreateRoomTooltip}">
                                <Path Data="{StaticResource IconPlus}"
                                      Stroke="White"
                                      StrokeThickness="2.2"
                                      Width="16" Height="16" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Thanh tìm kiếm hội thoại (Kính lõm) -->
                    <Border Background="{StaticResource GlassInputBrush}"
                            BorderBrush="#AAFFFFFF"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12,0"
                            Height="42">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Data="{StaticResource IconSearch}"
                                  Stroke="{StaticResource TextMutedBrush}"
                                  StrokeThickness="2"
                                  Width="15" Height="15" Stretch="Uniform"
                                  VerticalAlignment="Center" />
                            <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Tìm người, phòng hoặc nội dung..."
                                           FontSize="12.5"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding SearchQuery, Converter={StaticResource InverseStringToVis}}" />
                                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="13"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         CaretBrush="{StaticResource BrandSlateBrush}"
                                         VerticalContentAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Bộ lọc Gần đây / Chưa đọc -->
                <Grid Grid.Row="1" Margin="18,0,18,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding ListCountSummary}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Style="{StaticResource InlineGlassLinkButtonStyle}"
                            Command="{Binding ToggleFilterUnreadCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FilterButtonLabel}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrandSlateTextBrush}" />
                            <Path Data="{StaticResource IconChevronDown}"
                                  Stroke="{StaticResource BrandSlateTextBrush}"
                                  StrokeThickness="2"
                                  Width="11" Height="11" Stretch="Uniform"
                                  Margin="4,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Danh sách hội thoại -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="10,0,10,12">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding FilteredConversations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,0,5"
                                            Command="{Binding DataContext.SelectConversationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="RowBg"
                                                        CornerRadius="15"
                                                        Padding="11,10"
                                                        BorderThickness="1"
                                                        BorderBrush="Transparent"
                                                        Background="Transparent"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <TransformGroup>
                                                            <ScaleTransform x:Name="RowScale" ScaleX="1" ScaleY="1" />
                                                            <TranslateTransform x:Name="RowTrans" X="0" Y="0" />
                                                        </TransformGroup>
                                                    </Border.RenderTransform>
                                                    <Grid>
                                                        <Border x:Name="SelectedAccentBar"
                                                                Width="3.5"
                                                                Height="26"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                Margin="-8,0,0,0"
                                                                CornerRadius="2"
                                                                Background="{StaticResource DauSilkRedGradientBrush}"
                                                                Visibility="Collapsed" />
                                                        <ContentPresenter />
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="RowBg" Property="Background" Value="#D8FFFFFF" />
                                                        <Setter TargetName="RowBg" Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="RowScale" Storyboard.TargetProperty="ScaleX" To="1.012" Duration="0:0:0.17">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="RowScale" Storyboard.TargetProperty="ScaleY" To="1.012" Duration="0:0:0.17">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="RowTrans" Storyboard.TargetProperty="Y" To="-1.2" Duration="0:0:0.17">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="RowScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.20" />
                                                                    <DoubleAnimation Storyboard.TargetName="RowScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.20" />
                                                                    <DoubleAnimation Storyboard.TargetName="RowTrans" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.20" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="RowBg" Property="Background" Value="{StaticResource GlassSelectedRowBrush}" />
                                                        <Setter TargetName="RowBg" Property="BorderBrush" Value="{StaticResource GlassSelectedBorderBrush}" />
                                                        <Setter TargetName="SelectedAccentBar" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Avatar + chấm Online -->
                                            <Grid Grid.Column="0" Width="44" Height="44" Margin="0,0,12,0">
                                                <Border CornerRadius="14"
                                                        Background="{Binding AvatarBgHex, Converter={StaticResource HexToBrush}}">
                                                    <TextBlock Text="{Binding Initials}"
                                                               FontSize="12.5"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding AvatarFgHex, Converter={StaticResource HexToBrush}}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <Ellipse Width="12" Height="12"
                                                         Fill="{StaticResource EmeraldBrush}"
                                                         Stroke="White"
                                                         StrokeThickness="2.5"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Bottom"
                                                         Margin="0,0,-2,-2"
                                                         Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}" />
                                            </Grid>

                                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" Margin="0,0,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Title}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource BrandSlateTextBrush}" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <Path Data="{StaticResource IconBellOff}"
                                                              Stroke="{StaticResource TextFaintBrush}"
                                                              StrokeThickness="1.9"
                                                              Width="11" Height="11" Stretch="Uniform"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,5,0"
                                                              ToolTip="Đã tắt thông báo"
                                                              Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding TimeLabel}"
                                                                   FontSize="10.5"
                                                                   Foreground="{StaticResource TextFaintBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Subtitle}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Border Grid.Column="1"
                                                            Margin="8,0,0,0"
                                                            MinWidth="20"
                                                            Height="20"
                                                            Padding="6,0"
                                                            CornerRadius="10"
                                                            Background="{StaticResource DauSilkRedGradientBrush}"
                                                            Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding UnreadCount}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty Search State -->
                        <StackPanel Margin="20,48"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding FilteredConversations.Count, Converter={StaticResource ZeroToVis}}">
                            <Path Data="{StaticResource IconSearch}"
                                  Stroke="{StaticResource BorderStrongBrush}"
                                  StrokeThickness="1.8"
                                  Width="26" Height="26" Stretch="Uniform"
                                  HorizontalAlignment="Center" />
                            <TextBlock Text="Không tìm thấy kết quả"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0" />
                            <TextBlock Text="Thử từ khóa tên phòng hoặc giảng viên khác"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextFaintBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Thẻ trạng thái Local-First (Kính nhám) -->
                <Border Grid.Row="3"
                        Margin="14,0,14,14"
                        Background="#A8FFFFFF"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource EmeraldBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Local-first đang hoạt động"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                            <Path Grid.Column="1"
                                  Data="{StaticResource IconShieldCheck}"
                                  Stroke="{StaticResource EmeraldTextBrush}"
                                  StrokeThickness="2"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </Grid>
                        <TextBlock Text="Tin nhắn &amp; tệp được lưu riêng trên máy trạm (.jsonl + SHA-256)."
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
            </Border>
        </Grid>

        <!-- CỘT 2: KHÔNG GIAN CHAT CHÍNH (TÁCH LỚP BÓNG CACHED GPU — ZERO LAG KHI GÕ & CUỘN) -->
        <Grid Grid.Column="1">
            <Border CornerRadius="24"
                    BorderThickness="3"
                    BorderBrush="#5208131F"
                    Background="Transparent"
                    Effect="{StaticResource GlassPanelShadow}"
                    CacheMode="BitmapCache"
                    IsHitTestVisible="False" />
            <Border Background="{StaticResource GlassStageBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1.2"
                    CornerRadius="24">
        <Grid x:Name="ChatColumnGrid"
              Background="Transparent"
              AllowDrop="True"
              PreviewDragOver="ChatArea_PreviewDragOver"
              PreviewDragLeave="ChatArea_PreviewDragLeave"
              PreviewDrop="ChatArea_PreviewDrop">
            <Grid.RowDefinitions>
                <RowDefinition Height="74" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Lớp ánh sáng kính chéo + viền vát trong 1px + vi tinh thể nhám -->
            <Border Grid.Row="0" Grid.RowSpan="6" CornerRadius="23" IsHitTestVisible="False" Background="{StaticResource GlassDiagonalSheenBrush}" Opacity="0.65" />
            <Border Grid.Row="0" Grid.RowSpan="6" Margin="1" CornerRadius="22" BorderBrush="{StaticResource GlassInnerRimBrush}" BorderThickness="1" IsHitTestVisible="False" />
            <Border Grid.Row="0" Grid.RowSpan="6" CornerRadius="23" IsHitTestVisible="False" Background="{DynamicResource FrostedGrainBrush}" />

            <!-- Top Chat Header (Kính nhám đầu khung) -->
            <Border Grid.Row="0"
                    Background="{StaticResource GlassHeaderBrush}"
                    BorderBrush="{StaticResource GlassDividerBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="24,24,0,0"
                    Padding="22,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="42" Height="42" Margin="0,0,12,0">
                        <Border CornerRadius="13"
                                Background="{Binding SelectedConversation.AvatarBgHex, Converter={StaticResource HexToBrush}, FallbackValue={StaticResource DauRedSoftBrush}}">
                            <TextBlock Text="{Binding SelectedConversation.Initials, FallbackValue='LT'}"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="{Binding SelectedConversation.AvatarFgHex, Converter={StaticResource HexToBrush}, FallbackValue={StaticResource DauRedTextBrush}}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Ellipse Width="11" Height="11"
                                 Fill="{StaticResource EmeraldBrush}"
                                 Stroke="White"
                                 StrokeThickness="2"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,-2,-2"
                                 Visibility="{Binding SelectedConversation.IsOnline, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding SelectedConversation.Title, FallbackValue='Chưa chọn cuộc trò chuyện'}"
                                   FontSize="14.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SelectedConversation.MetaCaption}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="32"
                                Padding="10,4"
                                Background="{StaticResource BrandSlateTintBrush}"
                                BorderBrush="{StaticResource BrandSlateBorderBrush}"
                                Visibility="{Binding SelectedConversation.HasJoinCode, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                Command="{Binding CopyRoomJoinCodeCommand}"
                                ToolTip="Sao chép mã lớp / phòng">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCopy}" Stroke="{StaticResource BrandSlateTextBrush}" StrokeThickness="1.9" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedConversation.RoomJoinCode}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrandSlateTextBrush}"
                                           Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,4,0"
                                Style="{StaticResource IconButtonStyle}"
                                Visibility="{Binding CanEditOrDeleteSelectedRoom, Converter={StaticResource BoolToVis}}"
                                Command="{Binding OpenEditRoomCommand}"
                                ToolTip="Chỉnh sửa tên &amp; mô tả phòng">
                            <Path Data="{StaticResource IconEdit}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.9"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding ToggleMessageSearchCommand}"
                                ToolTip="Tìm kiếm trong hội thoại">
                            <Path Data="{StaticResource IconSearch}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.9"
                                  Width="18" Height="18" Stretch="Uniform" />
                        </Button>
                        <Button Margin="4,0,0,0"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding ToggleInfoDrawerCommand}"
                                ToolTip="Thông tin phòng &amp; Tệp chia sẻ">
                            <Path Data="{StaticResource IconInfo}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.9"
                                  Width="18" Height="18" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Thanh tìm kiếm trong hội thoại (Enter + Exit mượt) -->
            <Border Grid.Row="1"
                    infra:MotionBehavior.IsShown="{Binding ShowMessageSearch}"
                    infra:MotionBehavior.Preset="SlideDownFade"
                    Background="{StaticResource GlassHeaderBrush}"
                    BorderBrush="{StaticResource GlassDividerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,10">
                <Border Background="{StaticResource GlassInputBrush}" BorderBrush="#AAFFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconSearch}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Margin="10,0"
                                 Text="{Binding MessageSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="12.5" />
                        <Button Grid.Column="2"
                                Style="{StaticResource InlineGlassLinkButtonStyle}"
                                Content="Đóng"
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource BrandSlateTextBrush}"
                                Command="{Binding ToggleMessageSearchCommand}" />
                    </Grid>
                </Border>
            </Border>

            <!-- Thông báo đã ghim của Giảng viên (Enter + Exit mượt) -->
            <Border Grid.Row="2"
                    infra:MotionBehavior.IsShown="{Binding HasPinnedNotice}"
                    infra:MotionBehavior.Preset="SlideDownFade"
                    Margin="20,14,20,0"
                    Background="{StaticResource GlassDockBrush}"
                    BorderBrush="{StaticResource BrandSlateBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14,11"
                    Effect="{StaticResource GlassSoftShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="34" Height="34"
                            CornerRadius="10"
                            Background="{StaticResource DauRedSoftBrush}"
                            Margin="0,0,12,0">
                        <Path Data="{StaticResource IconPin}"
                              Stroke="{StaticResource DauRedTextBrush}"
                              StrokeThickness="2"
                              Width="16" Height="16" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="THÔNG BÁO ĐÃ GHIM"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource DauRedTextBrush}" />
                            <TextBlock Text="{Binding PinnedNoticeAuthor, StringFormat=' • {0}'}"
                                       FontSize="10.5"
                                       Foreground="{StaticResource TextFaintBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding PinnedNoticeContent}"
                                   FontSize="12.5"
                                   Foreground="{StaticResource TextBodyBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="{Binding CanPinThisRoom, Converter={StaticResource BoolToVis}}">
                        <Button Content="Sửa"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="30"
                                Padding="10,4"
                                FontSize="11"
                                Command="{Binding EditPinNoticeCommand}" />
                        <Button Margin="6,0,0,0"
                                Width="30" Height="30"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding UnpinNoticeCommand}"
                                ToolTip="Bỏ ghim thông báo">
                            <Path Data="{StaticResource IconClose}"
                                  Stroke="{StaticResource TextMutedBrush}"
                                  StrokeThickness="2"
                                  Width="13" Height="13" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Danh sách tin nhắn + Floating Jump-to-Latest Pill -->
            <Grid Grid.Row="3">
                <ScrollViewer x:Name="MessagesScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              Padding="24,16"
                              ScrollChanged="MessagesScrollViewer_ScrollChanged">
                    <StackPanel HorizontalAlignment="Stretch">


                        <ItemsControl ItemsSource="{Binding VisibleMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <!-- Divider ngày động -->
                                        <Grid Margin="0,6,0,14"
                                              Visibility="{Binding ShowDateDivider, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Height="1" Background="{StaticResource GlassDividerBrush}" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Background="#CCFFFFFF" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="11,3" Margin="10,0">
                                                <TextBlock Text="{Binding DateDividerLabel}"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                            </Border>
                                            <Border Grid.Column="2" Height="1" Background="{StaticResource GlassDividerBrush}" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- 1. Thông báo hệ thống -->
                                        <Border HorizontalAlignment="Center"
                                                Background="#B8E8EDF2"
                                                BorderBrush="#AAFFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="12,5"
                                                Visibility="{Binding IsSystemNotice, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Content}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>

                                        <!-- 2. Tin nhắn Text đến -->
                                        <Grid x:Name="IncomingTextRow"
                                              Background="Transparent"
                                              Visibility="{Binding IsIncomingText, Converter={StaticResource BoolToVis}}"
                                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              ContextMenu="{StaticResource MessageContextMenu}"
                                              ContextMenuOpening="MessageRow_ContextMenuOpening">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Grid MaxWidth="620">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                                            Width="34" Height="34"
                                                            CornerRadius="11"
                                                            VerticalAlignment="Top"
                                                            Margin="0,0,10,0"
                                                            Background="{Binding AvatarBgHex, Converter={StaticResource HexToBrush}}">
                                                        <TextBlock Text="{Binding SenderInitials}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding AvatarFgHex, Converter={StaticResource HexToBrush}}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                            <TextBlock Text="{Binding SenderName}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                                            <Border Margin="8,0,0,0"
                                                                    CornerRadius="5"
                                                                    Padding="6,1"
                                                                    Background="{StaticResource DauRedSoftBrush}"
                                                                    Visibility="{Binding HasRoleBadge, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding SenderRoleLabel}"
                                                                           FontSize="9.5"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource DauRedTextBrush}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding TimeText}"
                                                                       FontSize="10.5"
                                                                       Foreground="{StaticResource TextFaintBrush}"
                                                                       Margin="8,0,0,0"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <Border Background="{StaticResource GlassIncomingBubbleBrush}"
                                                                BorderBrush="{StaticResource GlassBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6,18,18,18"
                                                                Padding="14,11">
                                                            <StackPanel>
                                                                <Border Visibility="{Binding HasReplyQuote, Converter={StaticResource BoolToVis}}"
                                                                        Background="{StaticResource BrandSlateTintBrush}"
                                                                        BorderBrush="{StaticResource BrandSlateBrush}"
                                                                        BorderThickness="3,0,0,0"
                                                                        CornerRadius="7"
                                                                        Padding="9,6"
                                                                        Margin="0,0,0,8">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding ReplyAuthor}"
                                                                                   FontSize="11"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="{StaticResource BrandSlateTextBrush}" />
                                                                        <TextBlock Text="{Binding ReplySnippet}"
                                                                                   FontSize="11.5"
                                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Margin="0,2,0,0" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <TextBlock Text="{Binding BodyContent}"
                                                                           FontSize="13.5"
                                                                           LineHeight="20"
                                                                           Foreground="{StaticResource TextBodyBrush}"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel x:Name="IncomingTextActions"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            Margin="8,18,0,0"
                                                            Visibility="Hidden">
                                                    <Button Style="{StaticResource MsgMiniActionBtnStyle}"
                                                            Margin="0,0,4,0"
                                                            ToolTip="Trả lời"
                                                            Visibility="{Binding CanReplyThisMessage, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.ReplyToMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Path Data="{StaticResource IconReply}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" />
                                                    </Button>
                                                    <Button Style="{StaticResource MsgMiniActionBtnStyle}"
                                                            Margin="0,0,4,0"
                                                            ToolTip="Sao chép"
                                                            Visibility="{Binding CanCopyThisMessage, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Path Data="{StaticResource IconCopy}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" />
                                                    </Button>
                                                    <Button Style="{StaticResource MsgMiniActionBtnStyle}"
                                                            Margin="0,0,4,0"
                                                            ToolTip="Ghim tin nhắn"
                                                            Visibility="{Binding CanPinThisMessage, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.PinMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Path Data="{StaticResource IconPin}" Stroke="{StaticResource DauRedTextBrush}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" />
                                                    </Button>
                                                    <Button Style="{StaticResource MsgMiniActionBtnStyle}"
                                                            ToolTip="Xóa ở phía tôi"
                                                            Visibility="{Binding CanDeleteForMe, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.DeleteSingleMessageLocalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Path Data="{StaticResource IconTrash}" Stroke="{StaticResource DangerTextBrush}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" />
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 3. Tin nhắn Text gửi đi (Kính Xanh Lam Kiến Trúc) -->
                                        <Grid x:Name="OutgoingTextRow"
                                              Background="Transparent"
                                              Visibility="{Binding IsOutgoingText, Converter={StaticResource BoolToVis}}"
                                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              ContextMenu="{StaticResource MessageContextMenu}"
                                              ContextMenuOpening="MessageRow_ContextMenuOpening">
                                            <StackPanel HorizontalAlignment="Right">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <StackPanel x:Name="OutgoingTextActions"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,8,0"
                                                                Visibility="Hidden">
                                                        <Button Style="{StaticResource MsgMiniActionBtnStyle}"
                                                                Margin="0,0,4,0"
                                                                ToolTip="Trả lời"
                                                                Visibility="{Binding CanReplyThisMessage, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.ReplyToMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Path Data="{StaticResource IconReply}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" />
                                                        </Button>
                                                        <Button Style="{StaticResource MsgMiniActionBtnStyle}"
                                                                Margin="0,0,4,0"
                                                                ToolTip="Sao chép"
                                                                Visibility="{Binding CanCopyThisMessage, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Path Data="{StaticResource IconCopy}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" />
                                                        </Button>
                                                        <Button Style="{StaticResource MsgMiniActionBtnStyle}"
                                                                Margin="0,0,4,0"
                                                                ToolTip="Ghim tin nhắn"
                                                                Visibility="{Binding CanPinThisMessage, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.PinMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Path Data="{StaticResource IconPin}" Stroke="{StaticResource DauRedTextBrush}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" />
                                                        </Button>
                                                        <Button Style="{StaticResource MsgMiniActionBtnStyle}"
                                                                Margin="0,0,4,0"
                                                                ToolTip="Thu hồi"
                                                                Visibility="{Binding CanRecallThisMessage, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.RecallMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Path Data="{StaticResource IconRecall}" Stroke="#D97706" StrokeThickness="1.9" Width="12" Height="12" Stretch="Uniform" />
                                                        </Button>
                                                        <Button Style="{StaticResource MsgMiniActionBtnStyle}"
                                                                ToolTip="Xóa ở phía tôi"
                                                                Visibility="{Binding CanDeleteForMe, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.DeleteSingleMessageLocalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Path Data="{StaticResource IconTrash}" Stroke="{StaticResource DangerTextBrush}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" />
                                                        </Button>
                                                    </StackPanel>

                                                    <Border Background="{StaticResource GlassSlateBubbleBrush}"
                                                            BorderBrush="{StaticResource DarkGlassBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="18,6,18,18"
                                                            Padding="14,11"
                                                            MaxWidth="600">
                                                        <StackPanel>
                                                            <Border Visibility="{Binding HasReplyQuote, Converter={StaticResource BoolToVis}}"
                                                                    Background="#26FFFFFF"
                                                                    BorderBrush="#9CC2E4"
                                                                    BorderThickness="3,0,0,0"
                                                                    CornerRadius="7"
                                                                    Padding="9,6"
                                                                    Margin="0,0,0,8">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding ReplyAuthor}"
                                                                               FontSize="11"
                                                                               FontWeight="Bold"
                                                                               Foreground="White" />
                                                                    <TextBlock Text="{Binding ReplySnippet}"
                                                                               FontSize="11.5"
                                                                               Foreground="#D6E4F0"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Margin="0,2,0,0" />
                                                                </StackPanel>
                                                            </Border>
                                                            <TextBlock Text="{Binding BodyContent}"
                                                                       FontSize="13.5"
                                                                       LineHeight="20"
                                                                       Foreground="White"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,2,0">
                                                    <TextBlock Text="{Binding TimeText}" FontSize="10.5" Foreground="{StaticResource TextFaintBrush}" />
                                                    <Path Margin="5,0,0,0"
                                                          Data="{StaticResource IconCheckCheck}"
                                                          Stroke="{StaticResource BlueBrush}"
                                                          StrokeThickness="2"
                                                          Width="13" Height="13" Stretch="Uniform"
                                                          VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 4. Tệp & Ảnh đính kèm đến -->
                                        <Grid x:Name="IncomingAttachRow"
                                              Background="Transparent"
                                              Visibility="{Binding IsIncomingAttachment, Converter={StaticResource BoolToVis}}"
                                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              ContextMenu="{StaticResource MessageContextMenu}"
                                              ContextMenuOpening="MessageRow_ContextMenuOpening">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Grid Width="44" VerticalAlignment="Top">
                                                    <Border Width="34" Height="34"
                                                            CornerRadius="11"
                                                            HorizontalAlignment="Left"
                                                            Background="{Binding AvatarBgHex, Converter={StaticResource HexToBrush}}">
                                                        <TextBlock Text="{Binding SenderInitials}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding AvatarFgHex, Converter={StaticResource HexToBrush}}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>

                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding SenderName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding TimeText}" FontSize="10.5" Foreground="{StaticResource TextFaintBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <!-- Xem trước ảnh inline -->
                                                    <Border MaxWidth="320"
                                                            Background="{StaticResource SurfaceWhiteBrush}"
                                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="16"
                                                            Padding="8"
                                                            Visibility="{Binding HasImagePreview, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel>
                                                            <Button Style="{StaticResource GhostLiftButtonStyle}"
                                                                    Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="Bấm để mở ảnh kích thước đầy đủ">
                                                                <Border CornerRadius="10" ClipToBounds="True" Background="{StaticResource SurfaceInputBrush}">
                                                                    <Image Source="{Binding LocalFilePath, Converter={StaticResource PathToThumbnail}}"
                                                                           MaxWidth="296"
                                                                           MaxHeight="200"
                                                                           Stretch="Uniform" />
                                                                </Border>
                                                            </Button>
                                                            <Grid Margin="4,7,4,2">
                                                                <TextBlock Text="{Binding AttachmentFileName}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,105,0" />
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding AttachmentSizeText}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                    <Button Style="{StaticResource IconButtonStyle}"
                                                                            Width="24" Height="24"
                                                                            Command="{Binding DataContext.SaveFileAsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="Lưu ảnh về máy tính">
                                                                        <Path Data="{StaticResource IconDownload}" Stroke="{StaticResource DauRedTextBrush}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Thẻ tệp thường -->
                                                    <Border Width="346"
                                                            Background="{StaticResource SurfaceWhiteBrush}"
                                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="16"
                                                            Padding="12"
                                                            Visibility="{Binding IsFileCardWithoutPreview, Converter={StaticResource BoolToVis}}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0"
                                                                    Width="44" Height="44"
                                                                    CornerRadius="12"
                                                                    Background="{Binding AttachmentBadgeBgHex, Converter={StaticResource HexToBrush}}">
                                                                <TextBlock Text="{Binding AttachmentBadgeText}"
                                                                           FontSize="11"
                                                                           FontWeight="Bold"
                                                                           Foreground="{Binding AttachmentBadgeFgHex, Converter={StaticResource HexToBrush}}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding AttachmentFileName}"
                                                                           FontSize="12.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding AttachmentSizeText}"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           Margin="0,3,0,0" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Style="{StaticResource IconButtonStyle}"
                                                                        Width="30" Height="30" Margin="0,0,4,0"
                                                                        Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="Mở tệp ngay">
                                                                    <Path Data="{StaticResource IconEye}"
                                                                          Stroke="{StaticResource TextSecondaryBrush}"
                                                                          StrokeThickness="1.8"
                                                                          Width="15" Height="15" Stretch="Uniform" />
                                                                </Button>
                                                                <Button Style="{StaticResource IconButtonStyle}"
                                                                        Width="30" Height="30"
                                                                        Command="{Binding DataContext.SaveFileAsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="Lưu về máy tính (Save As)">
                                                                    <Path Data="{StaticResource IconDownload}"
                                                                          Stroke="{StaticResource DauRedTextBrush}"
                                                                          StrokeThickness="1.8"
                                                                          Width="15" Height="15" Stretch="Uniform" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel x:Name="IncomingAttachActions"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            Margin="8,14,0,0"
                                                            Visibility="Hidden">
                                                    <Button Style="{StaticResource MsgMiniActionBtnStyle}"
                                                            Margin="0,0,4,0"
                                                            ToolTip="Trả lời"
                                                            Visibility="{Binding CanReplyThisMessage, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.ReplyToMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Path Data="{StaticResource IconReply}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" />
                                                    </Button>
                                                    <Button Style="{StaticResource MsgMiniActionBtnStyle}"
                                                            Margin="0,0,4,0"
                                                            ToolTip="Sao chép tên tệp"
                                                            Visibility="{Binding CanCopyThisMessage, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Path Data="{StaticResource IconCopy}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" />
                                                    </Button>
                                                    <Button Style="{StaticResource MsgMiniActionBtnStyle}"
                                                            Margin="0,0,4,0"
                                                            ToolTip="Ghim tin nhắn"
                                                            Visibility="{Binding CanPinThisMessage, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.PinMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Path Data="{StaticResource IconPin}" Stroke="{StaticResource DauRedTextBrush}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" />
                                                    </Button>
                                                    <Button Style="{StaticResource MsgMiniActionBtnStyle}"
                                                            ToolTip="Xóa ở phía tôi"
                                                            Visibility="{Binding CanDeleteForMe, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.DeleteSingleMessageLocalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Path Data="{StaticResource IconTrash}" Stroke="{StaticResource DangerTextBrush}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" />
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 5. Tệp & Ảnh đính kèm gửi đi -->
                                        <Grid x:Name="OutgoingAttachRow"
                                              Background="Transparent"
                                              Visibility="{Binding IsOutgoingAttachment, Converter={StaticResource BoolToVis}}"
                                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              ContextMenu="{StaticResource MessageContextMenu}"
                                              ContextMenuOpening="MessageRow_ContextMenuOpening">
                                            <StackPanel HorizontalAlignment="Right">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <StackPanel x:Name="OutgoingAttachActions"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,8,0"
                                                                Visibility="Hidden">
                                                        <Button Style="{StaticResource MsgMiniActionBtnStyle}"
                                                                Margin="0,0,4,0"
                                                                ToolTip="Trả lời"
                                                                Visibility="{Binding CanReplyThisMessage, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.ReplyToMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Path Data="{StaticResource IconReply}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" />
                                                        </Button>
                                                        <Button Style="{StaticResource MsgMiniActionBtnStyle}"
                                                                Margin="0,0,4,0"
                                                                ToolTip="Sao chép tên tệp"
                                                                Visibility="{Binding CanCopyThisMessage, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Path Data="{StaticResource IconCopy}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" />
                                                        </Button>
                                                        <Button Style="{StaticResource MsgMiniActionBtnStyle}"
                                                                Margin="0,0,4,0"
                                                                ToolTip="Ghim tin nhắn"
                                                                Visibility="{Binding CanPinThisMessage, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.PinMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Path Data="{StaticResource IconPin}" Stroke="{StaticResource DauRedTextBrush}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" />
                                                        </Button>
                                                        <Button Style="{StaticResource MsgMiniActionBtnStyle}"
                                                                Margin="0,0,4,0"
                                                                ToolTip="Thu hồi"
                                                                Visibility="{Binding CanRecallThisMessage, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.RecallMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Path Data="{StaticResource IconRecall}" Stroke="#D97706" StrokeThickness="1.9" Width="12" Height="12" Stretch="Uniform" />
                                                        </Button>
                                                        <Button Style="{StaticResource MsgMiniActionBtnStyle}"
                                                                ToolTip="Xóa ở phía tôi"
                                                                Visibility="{Binding CanDeleteForMe, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.DeleteSingleMessageLocalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Path Data="{StaticResource IconTrash}" Stroke="{StaticResource DangerTextBrush}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" />
                                                        </Button>
                                                    </StackPanel>

                                                    <!-- Xem trước ảnh inline -->
                                                    <Border MaxWidth="320"
                                                            Background="{StaticResource SurfaceWhiteBrush}"
                                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="16"
                                                            Padding="8"
                                                            Visibility="{Binding HasImagePreview, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel>
                                                            <Button Style="{StaticResource GhostLiftButtonStyle}"
                                                                    Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="Bấm để mở ảnh kích thước đầy đủ">
                                                                <Border CornerRadius="10" ClipToBounds="True" Background="{StaticResource SurfaceInputBrush}">
                                                                    <Image Source="{Binding LocalFilePath, Converter={StaticResource PathToThumbnail}}"
                                                                           MaxWidth="296"
                                                                           MaxHeight="200"
                                                                           Stretch="Uniform" />
                                                                </Border>
                                                            </Button>
                                                            <Grid Margin="4,7,4,2">
                                                                <TextBlock Text="{Binding AttachmentFileName}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,105,0" />
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding AttachmentSizeText}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                    <Button Style="{StaticResource IconButtonStyle}"
                                                                            Width="24" Height="24"
                                                                            Command="{Binding DataContext.SaveFileAsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="Lưu ảnh về máy tính">
                                                                        <Path Data="{StaticResource IconDownload}" Stroke="{StaticResource DauRedTextBrush}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Thẻ tệp thường -->
                                                    <Border Width="360"
                                                            Background="{StaticResource SurfaceWhiteBrush}"
                                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="16"
                                                            Padding="12"
                                                            Visibility="{Binding IsFileCardWithoutPreview, Converter={StaticResource BoolToVis}}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0"
                                                                    Width="44" Height="44"
                                                                    CornerRadius="12"
                                                                    Background="{Binding AttachmentBadgeBgHex, Converter={StaticResource HexToBrush}}">
                                                                <TextBlock Text="{Binding AttachmentBadgeText}"
                                                                           FontSize="11"
                                                                           FontWeight="Bold"
                                                                           Foreground="{Binding AttachmentBadgeFgHex, Converter={StaticResource HexToBrush}}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding AttachmentFileName}"
                                                                           FontSize="12.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding AttachmentSizeText}"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           Margin="0,3,0,0" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Style="{StaticResource IconButtonStyle}"
                                                                        Width="30" Height="30" Margin="0,0,4,0"
                                                                        Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="Mở tệp ngay">
                                                                    <Path Data="{StaticResource IconEye}"
                                                                          Stroke="{StaticResource TextSecondaryBrush}"
                                                                          StrokeThickness="1.8"
                                                                          Width="15" Height="15" Stretch="Uniform" />
                                                                </Button>
                                                                <Button Style="{StaticResource IconButtonStyle}"
                                                                        Width="30" Height="30"
                                                                        Command="{Binding DataContext.SaveFileAsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="Lưu về máy tính (Save As)">
                                                                    <Path Data="{StaticResource IconDownload}"
                                                                          Stroke="{StaticResource DauRedTextBrush}"
                                                                          StrokeThickness="1.8"
                                                                          Width="15" Height="15" Stretch="Uniform" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,2,0">
                                                    <TextBlock Text="{Binding TimeText}" FontSize="10.5" Foreground="{StaticResource TextFaintBrush}" />
                                                    <TextBlock Text=" • SHA-256 ✓" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource EmeraldTextBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 6. Tin nhắn đã thu hồi đến -->
                                        <Grid x:Name="IncomingRecalledRow"
                                              Background="Transparent"
                                              Visibility="{Binding IsIncomingRecalled, Converter={StaticResource BoolToVis}}"
                                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              ContextMenu="{StaticResource MessageContextMenu}"
                                              ContextMenuOpening="MessageRow_ContextMenuOpening">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Grid MaxWidth="620">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                                            Width="34" Height="34"
                                                            CornerRadius="11"
                                                            VerticalAlignment="Top"
                                                            Margin="0,0,10,0"
                                                            Opacity="0.72"
                                                            Background="{Binding AvatarBgHex, Converter={StaticResource HexToBrush}}">
                                                        <TextBlock Text="{Binding SenderInitials}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding AvatarFgHex, Converter={StaticResource HexToBrush}}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                            <TextBlock Text="{Binding SenderName}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextMutedBrush}" />
                                                            <Border Margin="8,0,0,0"
                                                                    CornerRadius="5"
                                                                    Padding="6,1"
                                                                    Background="{StaticResource SurfaceInputBrush}"
                                                                    Visibility="{Binding HasRoleBadge, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding SenderRoleLabel}"
                                                                           FontSize="9.5"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource TextMutedBrush}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding TimeText}"
                                                                       FontSize="10.5"
                                                                       Foreground="{StaticResource TextFaintBrush}"
                                                                       Margin="8,0,0,0"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <Border Background="#CCFFFFFF"
                                                                BorderBrush="{StaticResource GlassBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6,16,16,16"
                                                                Padding="13,9">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="{StaticResource IconRecall}"
                                                                      Stroke="{StaticResource TextFaintBrush}"
                                                                      StrokeThickness="1.8"
                                                                      Width="13" Height="13" Stretch="Uniform"
                                                                      VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding BodyContent}"
                                                                           FontSize="12.5"
                                                                           FontStyle="Italic"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           Margin="7,0,0,0"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel x:Name="IncomingRecalledActions"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            Margin="8,18,0,0"
                                                            Visibility="Hidden">
                                                    <Button Style="{StaticResource MsgMiniActionBtnStyle}"
                                                            ToolTip="Xóa ở phía tôi"
                                                            Visibility="{Binding CanDeleteForMe, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.DeleteSingleMessageLocalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Path Data="{StaticResource IconTrash}" Stroke="{StaticResource DangerTextBrush}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" />
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 7. Tin nhắn đã thu hồi gửi đi -->
                                        <Grid x:Name="OutgoingRecalledRow"
                                              Background="Transparent"
                                              Visibility="{Binding IsOutgoingRecalled, Converter={StaticResource BoolToVis}}"
                                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              ContextMenu="{StaticResource MessageContextMenu}"
                                              ContextMenuOpening="MessageRow_ContextMenuOpening">
                                            <StackPanel HorizontalAlignment="Right">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <StackPanel x:Name="OutgoingRecalledActions"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,8,0"
                                                                Visibility="Hidden">
                                                        <Button Style="{StaticResource MsgMiniActionBtnStyle}"
                                                                ToolTip="Xóa ở phía tôi"
                                                                Visibility="{Binding CanDeleteForMe, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.DeleteSingleMessageLocalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Path Data="{StaticResource IconTrash}" Stroke="{StaticResource DangerTextBrush}" StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform" />
                                                        </Button>
                                                    </StackPanel>

                                                    <Border Background="#C2E6EEF6"
                                                            BorderBrush="{StaticResource GlassBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="16,6,16,16"
                                                            Padding="13,9"
                                                            MaxWidth="600">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconRecall}"
                                                                  Stroke="{StaticResource TextMutedBrush}"
                                                                  StrokeThickness="1.8"
                                                                  Width="13" Height="13" Stretch="Uniform"
                                                                  VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding BodyContent}"
                                                                       FontSize="12.5"
                                                                       FontStyle="Italic"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       Margin="7,0,0,0"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,2,0">
                                                    <TextBlock Text="{Binding TimeText}" FontSize="10.5" Foreground="{StaticResource TextFaintBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="IncomingTextRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="IncomingTextActions" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger SourceName="OutgoingTextRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="OutgoingTextActions" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger SourceName="IncomingAttachRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="IncomingAttachActions" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger SourceName="OutgoingAttachRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="OutgoingAttachActions" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger SourceName="IncomingRecalledRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="IncomingRecalledActions" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger SourceName="OutgoingRecalledRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="OutgoingRecalledActions" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Floating "Tin nhắn mới" pill khi người dùng đang cuộn đọc lịch sử cũ -->
                <Button HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,14"
                        Panel.ZIndex="10"
                        Cursor="Hand"
                        BorderThickness="0"
                        Background="Transparent"
                        Command="{Binding JumpToLatestCommand}"
                        infra:MotionBehavior.Preset="SlideUpFade"
                        infra:MotionBehavior.IsShown="{Binding HasUnseenScrollMessages}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="PillBg"
                                    Background="{StaticResource BrandSlateBrush}"
                                    BorderBrush="#36FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="14,7"
                                    Effect="{StaticResource SlatePillShadow}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconArrowDown}" Stroke="White" StrokeThickness="2.2" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding UnseenScrollPillText}" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="6,0,0,0" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PillBg" Property="Background" Value="{StaticResource BrandSlateHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Tiến trình Chunked Streaming đang chạy -->
            <ItemsControl Grid.Row="4" ItemsSource="{Binding ActiveTransfers}" Margin="22,0,22,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border MaxWidth="460"
                                HorizontalAlignment="Right"
                                Background="{StaticResource GlassDockBrush}"
                                BorderBrush="{StaticResource BrandSlateBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="12"
                                Margin="0,0,0,6"
                                Effect="{StaticResource GlassSoftShadow}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding FileName}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Percentage, StringFormat='{}{0:0}%'}"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrandSlateTextBrush}" />
                                </Grid>
                                <ProgressBar Height="6"
                                             Margin="0,8,0,6"
                                             Maximum="100"
                                             Value="{Binding Percentage}"
                                             Foreground="{StaticResource BrandSlateBrush}"
                                             Background="{StaticResource SurfaceInputBrush}"
                                             BorderThickness="0" />
                                <TextBlock Text="{Binding StatusText}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Thanh soạn tin nhắn dạng Dock Kính Nhám Nổi (Floating Frosted Composer Dock) -->
            <Border Grid.Row="5"
                    Margin="18,4,18,16"
                    Background="{StaticResource GlassDockBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1.2"
                    CornerRadius="20"
                    Padding="12,10"
                    Effect="{StaticResource GlassSoftShadow}"
                    Visibility="{Binding CanSendMessages, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Stretch">
                    <Border infra:MotionBehavior.IsShown="{Binding HasReplyingTo}"
                            infra:MotionBehavior.Preset="SlideUpFade"
                            Background="{StaticResource BrandSlateTintBrush}"
                            BorderBrush="{StaticResource BrandSlateBrush}"
                            BorderThickness="3,0,0,0"
                            CornerRadius="9"
                            Padding="12,8"
                            Margin="0,0,0,9">
                        <Grid>
                            <StackPanel Margin="0,0,34,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconReply}" Stroke="{StaticResource BrandSlateTextBrush}" StrokeThickness="2" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ReplyingToAuthor, StringFormat='Đang trả lời {0}'}"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrandSlateTextBrush}"
                                               Margin="6,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding ReplyingToSnippet}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Width="26" Height="26"
                                    Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding CancelReplyCommand}"
                                    ToolTip="Hủy trả lời (Esc)">
                                <Path Data="{StaticResource IconClose}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2" Width="12" Height="12" Stretch="Uniform" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- KHAY TÀI LIỆU CHỜ GỬI (STAGED FILES TRAY — ENTER + EXIT MƯỢT) -->
                    <Border infra:MotionBehavior.IsShown="{Binding HasStagedFiles}"
                            infra:MotionBehavior.Preset="SlideUpFade"
                            Background="{StaticResource SurfaceSubtleBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,10"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Path Data="{StaticResource IconPaperclip}" Stroke="{StaticResource DauRedTextBrush}" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StagedFilesSummary, StringFormat='Tệp đính kèm chờ gửi ({0}):'}"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="6,0,0,0" />
                                    <TextBlock Text="— nhập thêm lời nhắn rồi bấm Gửi"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="6,0,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource InlineGlassLinkButtonStyle}"
                                        Content="Hủy tất cả"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DauRedTextBrush}"
                                        Command="{Binding ClearStagedFilesCommand}" />
                            </Grid>

                            <!-- Danh sách chips tệp chờ gửi -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding StagedFiles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White"
                                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="8,5"
                                                    Margin="0,0,8,0"
                                                    MaxWidth="240">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            CornerRadius="6"
                                                            Padding="6,2"
                                                            Background="{Binding BadgeBgHex, Converter={StaticResource HexToBrush}}"
                                                            Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding BadgeText}"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding BadgeFgHex, Converter={StaticResource HexToBrush}}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding FileSizeText}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource TextMutedBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2"
                                                            Width="20" Height="20"
                                                            Margin="6,0,0,0"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            Command="{Binding DataContext.RemoveStagedFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Bỏ tệp này">
                                                        <Path Data="{StaticResource IconClose}"
                                                              Stroke="{StaticResource TextMutedBrush}"
                                                              StrokeThickness="2"
                                                              Width="10" Height="10" Stretch="Uniform" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource GlassInputBrush}"
                                BorderBrush="#99FFFFFF"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="6,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Style="{StaticResource IconButtonStyle}"
                                        Command="{Binding AttachFileCommand}"
                                        ToolTip="Đính kèm nhiều tệp / kéo-thả / Ctrl+V dán ảnh (Chunk 64KB + SHA-256)">
                                    <Path Data="{StaticResource IconPaperclip}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.9"
                                          Width="18" Height="18" Stretch="Uniform" />
                                </Button>

                                <Grid Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ComposerPlaceholder}"
                                               FontSize="13"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding DraftMessage, Converter={StaticResource InverseStringToVis}}" />
                                    <TextBox x:Name="ComposerTextBox"
                                             Text="{Binding DraftMessage, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontSize="13.5"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             CaretBrush="{StaticResource BrandSlateBrush}"
                                             AcceptsReturn="True"
                                             MaxHeight="96"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             PreviewKeyDown="ComposerTextBox_PreviewKeyDown" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Button Grid.Column="1"
                                Margin="10,0,0,0"
                                Width="44" Height="44"
                                Style="{StaticResource BrandSquareIconButtonStyle}"
                                Command="{Binding SendMessageCommand}"
                                ToolTip="Gửi tin nhắn (Enter)">
                            <Path Data="{StaticResource IconSend}"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  Width="18" Height="18" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Thanh Quản trị phòng chat (Hiển thị riêng cho Admin - Dock kính nổi) -->
            <Border Grid.Row="5"
                    Margin="18,4,18,16"
                    Background="{StaticResource GlassDockBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1.2"
                    CornerRadius="18"
                    Padding="16,12"
                    Effect="{StaticResource GlassSoftShadow}"
                    Visibility="{Binding IsAdminMode, Converter={StaticResource BoolToVis}}">
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource DauRedSoftBrush}">
                            <Path Data="{StaticResource IconShieldCheck}" Stroke="{StaticResource DauRedTextBrush}" StrokeThickness="1.9" Width="15" Height="15" Stretch="Uniform" />
                        </Border>
                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Quản trị Phòng chat" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Quản lý phòng &amp; thành viên" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="33"
                                Padding="9,5"
                                Margin="0,0,6,0"
                                FontSize="12"
                                Content="Sửa phòng"
                                Command="{Binding OpenEditRoomCommand}" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="33"
                                Padding="9,5"
                                Margin="0,0,6,0"
                                FontSize="12"
                                Content="+ Thành viên"
                                Command="{Binding OpenAddMemberCommand}" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="33"
                                Padding="9,5"
                                FontSize="12"
                                Foreground="{StaticResource DangerTextBrush}"
                                Content="Xóa phòng"
                                Command="{Binding DeleteRoomCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Drop Files Overlay khi kéo tệp vào vùng chat -->
            <Border x:Name="DropFilesOverlay"
                    Grid.Row="0"
                    Grid.RowSpan="6"
                    Panel.ZIndex="20"
                    CornerRadius="24"
                    Background="#E2EEF3F8"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource GlassModalBrush}"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1.2"
                        CornerRadius="22"
                        Padding="34,26"
                        Effect="{StaticResource GlassModalShadow}">
                    <Grid>
                        <Rectangle Stroke="{StaticResource BrandSlateBrush}"
                                   StrokeThickness="2"
                                   StrokeDashArray="4 3"
                                   RadiusX="14"
                                   RadiusY="14"
                                   Margin="-14" />
                        <StackPanel HorizontalAlignment="Center" Margin="8,4">
                            <Border Width="54" Height="54" CornerRadius="16" Background="{StaticResource BrandSlateSoftBrush}" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconUpload}" Stroke="{StaticResource BrandSlateTextBrush}" StrokeThickness="2" Width="24" Height="24" Stretch="Uniform" />
                            </Border>
                            <TextBlock Text="Thả tệp hoặc ảnh để gửi ngay"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0" />
                            <TextBlock Text="Hỗ trợ kéo nhiều tệp cùng lúc • Truyền luồng 64KB + xác thực SHA-256"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Grid>
            </Border>
        </Grid>

        <!-- CỘT 3: DRAWER THÔNG TIN PHÒNG (ENTER + EXIT TRƯỢT MƯỢT TỪ PHẢI — BÓNG CACHED GPU) -->
        <Grid Grid.Column="2"
              Width="292"
              Margin="12,0,0,0"
              infra:MotionBehavior.Preset="DrawerRight"
              infra:MotionBehavior.IsShown="{Binding IsInfoDrawerOpen}">
            <Border CornerRadius="24"
                    BorderThickness="3"
                    BorderBrush="#5208131F"
                    Background="Transparent"
                    Effect="{StaticResource GlassPanelShadow}"
                    CacheMode="BitmapCache"
                    IsHitTestVisible="False" />
            <Border Background="{StaticResource GlassPanelBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1.3"
                    CornerRadius="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="74" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.RowSpan="2" CornerRadius="23" IsHitTestVisible="False" Background="{StaticResource GlassDiagonalSheenBrush}" />
                <Border Grid.RowSpan="2" Margin="1" CornerRadius="22" BorderBrush="{StaticResource GlassInnerRimBrush}" BorderThickness="1" IsHitTestVisible="False" />

                <Border Grid.Row="0"
                        Background="{StaticResource GlassHeaderBrush}"
                        BorderBrush="{StaticResource GlassDividerBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="24,24,0,0"
                        Padding="18,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding InfoHeaderTitle}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding ToggleInfoDrawerCommand}"
                                ToolTip="Đóng bảng thông tin">
                            <Path Data="{StaticResource IconClose}"
                                  Stroke="{StaticResource TextMutedBrush}"
                                  StrokeThickness="2"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Thông tin tổng quan -->
                        <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="18,16">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="58" Height="58" CornerRadius="17"
                                        Background="{Binding SelectedConversation.AvatarBgHex, Converter={StaticResource HexToBrush}, FallbackValue={StaticResource DauRedSoftBrush}}">
                                    <TextBlock Text="{Binding SelectedConversation.Initials, FallbackValue='LT'}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="{Binding SelectedConversation.AvatarFgHex, Converter={StaticResource HexToBrush}, FallbackValue={StaticResource DauRedTextBrush}}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding SelectedConversation.Title}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0" />
                                <TextBlock Text="{Binding SelectedConversation.MetaCaption}"
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,3,0,0" />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                    <Button Style="{StaticResource GhostLiftButtonStyle}" Command="{Binding ToggleMuteCommand}" Margin="6,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="40" Height="40" CornerRadius="13" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource GlassCardBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelectedConversationMuted}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource DauRedSoftBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Path StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Data" Value="{StaticResource IconBell}" />
                                                            <Setter Property="Stroke" Value="{StaticResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelectedConversationMuted}" Value="True">
                                                                    <Setter Property="Data" Value="{StaticResource IconBellOff}" />
                                                                    <Setter Property="Stroke" Value="{StaticResource DauRedTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Border>
                                            <TextBlock Text="{Binding SelectedConversationMuteLabel}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,5,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelectedConversationMuted}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource DauRedTextBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource GhostLiftButtonStyle}"
                                            Command="{Binding EditPinNoticeCommand}"
                                            Visibility="{Binding CanPinThisRoom, Converter={StaticResource BoolToVis}}"
                                            Margin="6,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="40" Height="40" CornerRadius="13" Background="{StaticResource DauRedSoftBrush}" BorderBrush="{StaticResource DauRedBorderBrush}" BorderThickness="1">
                                                <Path Data="{StaticResource IconPin}" Stroke="{StaticResource DauRedTextBrush}" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Text="Ghim tin" FontSize="10.5" Foreground="{StaticResource DauRedTextBrush}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource GhostLiftButtonStyle}"
                                            Command="{Binding OpenEditRoomCommand}"
                                            Visibility="{Binding CanEditOrDeleteSelectedRoom, Converter={StaticResource BoolToVis}}"
                                            Margin="6,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="40" Height="40" CornerRadius="13" Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                                <Path Data="{StaticResource IconEdit}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Text="Sửa phòng" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource GhostLiftButtonStyle}" Command="{Binding ToggleMessageSearchCommand}" Margin="6,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="40" Height="40" CornerRadius="13" Background="{StaticResource GlassCardBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                                <Path Data="{StaticResource IconSearch}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Text="Tìm kiếm" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <Button Margin="0,12,0,0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        MinHeight="34"
                                        Padding="12,5"
                                        Background="{StaticResource BrandSlateTintBrush}"
                                        BorderBrush="{StaticResource BrandSlateBorderBrush}"
                                        Visibility="{Binding SelectedConversation.HasJoinCode, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                        Command="{Binding CopyRoomJoinCodeCommand}"
                                        ToolTip="Bấm để sao chép mã tham gia lớp / phòng">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Mã tham gia:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding SelectedConversation.RoomJoinCode}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource BrandSlateTextBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Thành viên phòng -->
                        <Border BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="18,13"
                                Visibility="{Binding SelectedConversation.IsRoom, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding RoomMembers.Count, StringFormat='Thành viên ({0})'}"
                                               FontSize="12.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Visibility="{Binding CanManageSelectedRoomMembers, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding OpenAddMemberCommand}"
                                            Background="{StaticResource DauRedSoftBrush}"
                                            BorderThickness="0"
                                            Padding="9,5"
                                            Cursor="Hand"
                                            ToolTip="Thêm thành viên vào phòng">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconUserPlus}" Stroke="{StaticResource DauRedTextBrush}" StrokeThickness="2" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                                                        <TextBlock Text="Thêm" Margin="5,0,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DauRedTextBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding RoomMembers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,10,0">
                                                    <Border CornerRadius="10" Background="{Binding AvatarBgHex, Converter={StaticResource HexToBrush}}">
                                                        <TextBlock Text="{Binding Initials}" FontSize="10" FontWeight="Bold" Foreground="{Binding AvatarFgHex, Converter={StaticResource HexToBrush}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Ellipse Width="9" Height="9"
                                                             Fill="{Binding Presence, Converter={StaticResource PresenceToBrush}}"
                                                             Stroke="White" StrokeThickness="1.5"
                                                             HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FullName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBodyBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Role, Converter={StaticResource RoleDisplay}}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Width="26" Height="26"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Visibility="{Binding CanBeRemoved, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Xóa thành viên khỏi phòng">
                                                    <Path Data="{StaticResource IconUserX}" Stroke="{StaticResource DangerTextBrush}" StrokeThickness="1.8" Width="13" Height="13" Stretch="Uniform" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Tệp đã chia sẻ -->
                        <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="18,13">
                            <StackPanel>
                                <TextBlock Text="Tệp đã chia sẻ" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding RoomSharedFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Margin="0,0,10,0"
                                                        Background="{Binding IconBgHex, Converter={StaticResource HexToBrush}}">
                                                    <Path Data="{StaticResource IconFileText}" Stroke="{Binding IconFgHex, Converter={StaticResource HexToBrush}}" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextBodyBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding SizeAndTimeText}" FontSize="10" Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource IconButtonStyle}"
                                                            Width="26" Height="26" Margin="0,0,3,0"
                                                            Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Mở tệp ngay">
                                                        <Path Data="{StaticResource IconEye}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.8" Width="13" Height="13" Stretch="Uniform" />
                                                    </Button>
                                                    <Button Style="{StaticResource IconButtonStyle}"
                                                            Width="26" Height="26"
                                                            Command="{Binding DataContext.SaveFileAsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Lưu về máy tính (Save As)">
                                                        <Path Data="{StaticResource IconDownload}" Stroke="{StaticResource DauRedTextBrush}" StrokeThickness="1.8" Width="13" Height="13" Stretch="Uniform" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Chưa có tài liệu chia sẻ trong hội thoại này."
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextFaintBrush}"
                                           Visibility="{Binding RoomSharedFiles.Count, Converter={StaticResource ZeroToVis}}" />
                            </StackPanel>
                        </Border>

                        <!-- Thao tác quản lý Local & Phòng -->
                        <StackPanel Margin="14,10,14,14">
                            <Button Style="{StaticResource DangerGhostButtonStyle}"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Visibility="{Binding CanSendMessages, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DeleteLocalHistoryCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconTrash}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="Xóa lịch sử ở phía tôi" Margin="10,0,0,0" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource DangerGhostButtonStyle}"
                                    Visibility="{Binding CanLeaveSelectedRoom, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding LeaveRoomCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconClose}" Stroke="{StaticResource DangerTextBrush}" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="Rời khỏi phòng" Margin="11,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource DangerTextBrush}" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource DangerGhostButtonStyle}"
                                    Visibility="{Binding CanEditOrDeleteSelectedRoom, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DeleteRoomCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconTrash}" Stroke="{StaticResource DangerTextBrush}" StrokeThickness="1.9" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="Giải tán / Xóa phòng" Margin="11,0,0,0" FontSize="12" FontWeight="Bold" Foreground="{StaticResource DangerTextBrush}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
