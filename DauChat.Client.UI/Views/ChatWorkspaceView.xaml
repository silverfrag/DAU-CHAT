<UserControl x:Class="DauChat.Client.UI.Views.ChatWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1200">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- CỘT 1: DANH SÁCH HỘI THOẠI / PHÒNG HỌC -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceWhiteBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header danh sách -->
                <StackPanel Grid.Row="0" Margin="20,20,20,14">
                    <Grid Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="DAU CONNECT"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource DauRedTextBrush}" />
                            <TextBlock Text="{Binding SidebarHeading}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    MinHeight="36"
                                    Padding="11,5"
                                    BorderBrush="{StaticResource DauRedBorderBrush}"
                                    Background="{StaticResource DauRedSoftBrush}"
                                    Foreground="{StaticResource DauRedTextBrush}"
                                    Visibility="{Binding CanJoinByCode, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding OpenJoinByCodeCommand}"
                                    ToolTip="Tham gia lớp học bằng mã lớp (Google Classroom)">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconHash}"
                                          Stroke="{StaticResource DauRedTextBrush}"
                                          StrokeThickness="2.2"
                                          Width="12" Height="12" Stretch="Uniform"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Mã lớp" Margin="5,0,0,0" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource DauRedTextBrush}" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource BrandSquareIconButtonStyle}"
                                    Visibility="{Binding CanManageRooms, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding OpenCreateRoomCommand}"
                                    ToolTip="Tạo phòng học mới">
                                <Path Data="{StaticResource IconPlus}"
                                      Stroke="White"
                                      StrokeThickness="2.2"
                                      Width="18" Height="18" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Thanh tìm kiếm hội thoại -->
                    <Border Background="{StaticResource SurfaceInputBrush}"
                            CornerRadius="12"
                            Padding="12,0"
                            Height="42">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Data="{StaticResource IconSearch}"
                                  Stroke="{StaticResource TextFaintBrush}"
                                  StrokeThickness="2"
                                  Width="16" Height="16" Stretch="Uniform"
                                  VerticalAlignment="Center" />
                            <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Tìm người, phòng hoặc nội dung..."
                                           FontSize="12.5"
                                           Foreground="{StaticResource TextFaintBrush}"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding SearchQuery, Converter={StaticResource InverseStringToVis}}" />
                                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="13"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         CaretBrush="{StaticResource DauRedBrush}"
                                         VerticalContentAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Bộ lọc Gần đây / Chưa đọc -->
                <Grid Grid.Row="1" Margin="20,0,20,8">
                    <TextBlock Text="{Binding ListCountSummary}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right"
                            Command="{Binding ToggleFilterUnreadCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Padding="4,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FilterButtonLabel}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource DauRedTextBrush}" />
                            <Path Data="{StaticResource IconChevronDown}"
                                  Stroke="{StaticResource DauRedTextBrush}"
                                  StrokeThickness="2"
                                  Width="11" Height="11" Stretch="Uniform"
                                  Margin="4,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Danh sách hội thoại -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="8,0,8,12">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding FilteredConversations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,0,4"
                                            Command="{Binding DataContext.SelectConversationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="RowBg"
                                                        CornerRadius="14"
                                                        Padding="12,11"
                                                        Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="RowBg" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="RowBg" Property="Background" Value="{StaticResource DauRedSoftBrush}" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Avatar + chấm Online -->
                                            <Grid Grid.Column="0" Width="44" Height="44" Margin="0,0,12,0">
                                                <Border CornerRadius="14"
                                                        Background="{Binding AvatarBgHex, Converter={StaticResource HexToBrush}}">
                                                    <TextBlock Text="{Binding Initials}"
                                                               FontSize="12.5"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding AvatarFgHex, Converter={StaticResource HexToBrush}}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <Ellipse Width="12" Height="12"
                                                         Fill="{StaticResource EmeraldBrush}"
                                                         Stroke="White"
                                                         StrokeThickness="2.5"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Bottom"
                                                         Margin="0,0,-2,-2"
                                                         Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}" />
                                            </Grid>

                                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" Margin="0,0,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Title}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource DauRedSelectedTextBrush}" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding TimeLabel}"
                                                               FontSize="10.5"
                                                               Foreground="{StaticResource TextFaintBrush}"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </Grid>

                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Subtitle}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Border Grid.Column="1"
                                                            Margin="8,0,0,0"
                                                            MinWidth="20"
                                                            Height="20"
                                                            Padding="6,0"
                                                            CornerRadius="10"
                                                            Background="{StaticResource DauRedBrush}"
                                                            Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding UnreadCount}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty Search State -->
                        <StackPanel Margin="20,48"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding FilteredConversations.Count, Converter={StaticResource ZeroToVis}}">
                            <Path Data="{StaticResource IconSearch}"
                                  Stroke="{StaticResource BorderStrongBrush}"
                                  StrokeThickness="1.8"
                                  Width="26" Height="26" Stretch="Uniform"
                                  HorizontalAlignment="Center" />
                            <TextBlock Text="Không tìm thấy kết quả"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0" />
                            <TextBlock Text="Thử từ khóa tên phòng hoặc giảng viên khác"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextFaintBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Thẻ trạng thái Local-First -->
                <Border Grid.Row="3"
                        Margin="16,0,16,16"
                        Background="{StaticResource SurfaceSubtleBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource EmeraldBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Local-first đang hoạt động"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                            <Path HorizontalAlignment="Right"
                                  Data="{StaticResource IconShieldCheck}"
                                  Stroke="{StaticResource EmeraldTextBrush}"
                                  StrokeThickness="2"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </Grid>
                        <TextBlock Text="Tin nhắn &amp; tệp được lưu riêng trên máy trạm (.jsonl + SHA-256)."
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- CỘT 2: KHÔNG GIAN CHAT CHÍNH -->
        <Grid Grid.Column="1" Background="{StaticResource CanvasBgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="74" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Chat Header (Không có Call/Video thừa thãi) -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceWhiteBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="42" Height="42" Margin="0,0,12,0">
                        <Border CornerRadius="13"
                                Background="{Binding SelectedConversation.AvatarBgHex, Converter={StaticResource HexToBrush}, FallbackValue={StaticResource DauRedSoftBrush}}">
                            <TextBlock Text="{Binding SelectedConversation.Initials, FallbackValue='LT'}"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="{Binding SelectedConversation.AvatarFgHex, Converter={StaticResource HexToBrush}, FallbackValue={StaticResource DauRedTextBrush}}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Ellipse Width="11" Height="11"
                                 Fill="{StaticResource EmeraldBrush}"
                                 Stroke="White"
                                 StrokeThickness="2"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,-2,-2"
                                 Visibility="{Binding SelectedConversation.IsOnline, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding SelectedConversation.Title, FallbackValue='Chưa chọn cuộc trò chuyện'}"
                                   FontSize="14.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SelectedConversation.MetaCaption}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="32"
                                Padding="10,4"
                                Background="{StaticResource SurfaceSubtleBrush}"
                                Visibility="{Binding SelectedConversation.HasJoinCode, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                Command="{Binding CopyRoomJoinCodeCommand}"
                                ToolTip="Sao chép mã lớp / phòng">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCopy}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.9" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedConversation.RoomJoinCode}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource DauRedTextBrush}"
                                           Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,4,0"
                                Style="{StaticResource IconButtonStyle}"
                                Visibility="{Binding CanEditOrDeleteSelectedRoom, Converter={StaticResource BoolToVis}}"
                                Command="{Binding OpenEditRoomCommand}"
                                ToolTip="Chỉnh sửa tên &amp; mô tả phòng">
                            <Path Data="{StaticResource IconEdit}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.9"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding ToggleMessageSearchCommand}"
                                ToolTip="Tìm kiếm trong hội thoại">
                            <Path Data="{StaticResource IconSearch}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.9"
                                  Width="18" Height="18" Stretch="Uniform" />
                        </Button>
                        <Button Margin="4,0,0,0"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding ToggleInfoDrawerCommand}"
                                ToolTip="Thông tin phòng &amp; Tệp chia sẻ">
                            <Path Data="{StaticResource IconInfo}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.9"
                                  Width="18" Height="18" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Thanh tìm kiếm trong hội thoại -->
            <Border Grid.Row="1"
                    Visibility="{Binding ShowMessageSearch, Converter={StaticResource BoolToVis}}"
                    Background="{StaticResource SurfaceWhiteBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,10">
                <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="10" Padding="12,6" MaxWidth="680">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconSearch}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Margin="10,0"
                                 Text="{Binding MessageSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="12.5" />
                        <Button Grid.Column="2"
                                Content="Đóng"
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DauRedTextBrush}"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding ToggleMessageSearchCommand}" />
                    </Grid>
                </Border>
            </Border>

            <!-- Thông báo đã ghim của Giảng viên -->
            <Border Grid.Row="2"
                    Visibility="{Binding HasPinnedNotice, Converter={StaticResource BoolToVis}}"
                    Margin="20,14,20,0"
                    Background="{StaticResource SurfaceWhiteBrush}"
                    BorderBrush="{StaticResource DauRedBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="34" Height="34"
                            CornerRadius="10"
                            Background="{StaticResource DauRedSoftBrush}"
                            Margin="0,0,12,0">
                        <Path Data="{StaticResource IconPin}"
                              Stroke="{StaticResource DauRedTextBrush}"
                              StrokeThickness="2"
                              Width="16" Height="16" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="THÔNG BÁO ĐÃ GHIM"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource DauRedTextBrush}" />
                            <TextBlock Text="{Binding PinnedNoticeAuthor, StringFormat=' • {0}'}"
                                       FontSize="10.5"
                                       Foreground="{StaticResource TextFaintBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding PinnedNoticeContent}"
                                   FontSize="12.5"
                                   Foreground="{StaticResource TextBodyBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="{Binding CanPinThisRoom, Converter={StaticResource BoolToVis}}">
                        <Button Content="Sửa"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="30"
                                Padding="10,4"
                                FontSize="11"
                                Command="{Binding EditPinNoticeCommand}" />
                        <Button Margin="6,0,0,0"
                                Width="30" Height="30"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding UnpinNoticeCommand}"
                                ToolTip="Bỏ ghim thông báo">
                            <Path Data="{StaticResource IconClose}"
                                  Stroke="{StaticResource TextMutedBrush}"
                                  StrokeThickness="2"
                                  Width="13" Height="13" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Danh sách tin nhắn -->
            <ScrollViewer x:Name="MessagesScrollViewer"
                          Grid.Row="3"
                          VerticalScrollBarVisibility="Auto"
                          Padding="22,18">
                <StackPanel MaxWidth="760">
                    <!-- Divider ngày -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="1" Background="{StaticResource BorderSubtleBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="LỊCH SỬ TRÒ CHUYỆN LOCAL (.JSONL)"
                                   Margin="12,0"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextFaintBrush}" />
                        <Border Grid.Column="2" Height="1" Background="{StaticResource BorderSubtleBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding VisibleMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,14">
                                    <!-- 1. Thông báo hệ thống -->
                                    <Border HorizontalAlignment="Center"
                                            Background="#E2E8F0"
                                            CornerRadius="12"
                                            Padding="12,5"
                                            Visibility="{Binding IsSystemNotice, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Content}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>

                                    <!-- 2. Tin nhắn Text đến -->
                                    <Grid HorizontalAlignment="Left"
                                          MaxWidth="520"
                                          Visibility="{Binding IsIncomingText, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="34" Height="34"
                                                CornerRadius="11"
                                                VerticalAlignment="Top"
                                                Margin="0,0,10,0"
                                                Background="{Binding AvatarBgHex, Converter={StaticResource HexToBrush}}">
                                            <TextBlock Text="{Binding SenderInitials}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding AvatarFgHex, Converter={StaticResource HexToBrush}}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="{Binding SenderName}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                <Border Margin="8,0,0,0"
                                                        CornerRadius="5"
                                                        Padding="6,1"
                                                        Background="{StaticResource DauRedSoftBrush}"
                                                        Visibility="{Binding HasRoleBadge, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding SenderRoleLabel}"
                                                               FontSize="9.5"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource DauRedTextBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding TimeText}"
                                                           FontSize="10.5"
                                                           Foreground="{StaticResource TextFaintBrush}"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <Border Background="{StaticResource SurfaceWhiteBrush}"
                                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6,16,16,16"
                                                    Padding="14,11">
                                                <TextBlock Text="{Binding Content}"
                                                           FontSize="13.5"
                                                           LineHeight="20"
                                                           Foreground="{StaticResource TextBodyBrush}"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 3. Tin nhắn Text gửi đi (#CB0914) -->
                                    <StackPanel HorizontalAlignment="Right"
                                                MaxWidth="520"
                                                Visibility="{Binding IsOutgoingText, Converter={StaticResource BoolToVis}}">
                                        <Border Background="{StaticResource DauRedBrush}"
                                                CornerRadius="16,6,16,16"
                                                Padding="14,11">
                                            <TextBlock Text="{Binding Content}"
                                                       FontSize="13.5"
                                                       LineHeight="20"
                                                       Foreground="White"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,2,0">
                                            <TextBlock Text="{Binding TimeText}" FontSize="10.5" Foreground="{StaticResource TextFaintBrush}" />
                                            <Path Margin="5,0,0,0"
                                                  Data="{StaticResource IconCheckCheck}"
                                                  Stroke="{StaticResource BlueBrush}"
                                                  StrokeThickness="2"
                                                  Width="13" Height="13" Stretch="Uniform"
                                                  VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 4. Tệp đính kèm đến -->
                                    <Grid HorizontalAlignment="Left"
                                          Width="390"
                                          Visibility="{Binding IsIncomingAttachment, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="1"
                                                Background="{StaticResource SurfaceWhiteBrush}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="16"
                                                Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Width="44" Height="44"
                                                        CornerRadius="12"
                                                        Background="{Binding AttachmentBadgeBgHex, Converter={StaticResource HexToBrush}}">
                                                    <TextBlock Text="{Binding AttachmentBadgeText}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding AttachmentBadgeFgHex, Converter={StaticResource HexToBrush}}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AttachmentFileName}"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding AttachmentSizeText}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Mở / Kiểm tra tệp">
                                                    <Path Data="{StaticResource IconDownload}"
                                                          Stroke="{StaticResource DauRedTextBrush}"
                                                          StrokeThickness="2"
                                                          Width="16" Height="16" Stretch="Uniform" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- 5. Tệp đính kèm gửi đi -->
                                    <StackPanel HorizontalAlignment="Right"
                                                Width="390"
                                                Visibility="{Binding IsOutgoingAttachment, Converter={StaticResource BoolToVis}}">
                                        <Border Background="{StaticResource SurfaceWhiteBrush}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="16"
                                                Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Width="44" Height="44"
                                                        CornerRadius="12"
                                                        Background="{Binding AttachmentBadgeBgHex, Converter={StaticResource HexToBrush}}">
                                                    <TextBlock Text="{Binding AttachmentBadgeText}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding AttachmentBadgeFgHex, Converter={StaticResource HexToBrush}}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AttachmentFileName}"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding AttachmentSizeText}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Mở tệp Local">
                                                    <Path Data="{StaticResource IconDownload}"
                                                          Stroke="{StaticResource TextSecondaryBrush}"
                                                          StrokeThickness="2"
                                                          Width="16" Height="16" Stretch="Uniform" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,2,0">
                                            <TextBlock Text="{Binding TimeText}" FontSize="10.5" Foreground="{StaticResource TextFaintBrush}" />
                                            <TextBlock Text=" • SHA-256 ✓" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource EmeraldTextBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Tiến trình Chunked Streaming đang chạy -->
            <ItemsControl Grid.Row="4" ItemsSource="{Binding ActiveTransfers}" Margin="22,0,22,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border MaxWidth="460"
                                HorizontalAlignment="Right"
                                Background="{StaticResource SurfaceWhiteBrush}"
                                BorderBrush="{StaticResource DauRedBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="12"
                                Margin="0,0,0,6">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding FileName}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock HorizontalAlignment="Right"
                                               Text="{Binding Percentage, StringFormat='{}{0:0}%'}"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource DauRedTextBrush}" />
                                </Grid>
                                <ProgressBar Height="6"
                                             Margin="0,8,0,6"
                                             Maximum="100"
                                             Value="{Binding Percentage}"
                                             Foreground="{StaticResource DauRedBrush}"
                                             Background="{StaticResource SurfaceInputBrush}"
                                             BorderThickness="0" />
                                <TextBlock Text="{Binding StatusText}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Thanh soạn tin nhắn (Text + Đính kèm tệp thực tế cho GV/SV) -->
            <Border Grid.Row="5"
                    Background="{StaticResource SurfaceWhiteBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,12"
                    Visibility="{Binding CanSendMessages, Converter={StaticResource BoolToVis}}">
                <Grid MaxWidth="760">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{StaticResource SurfaceSubtleBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="15"
                            Padding="6,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding AttachFileCommand}"
                                    ToolTip="Gửi tệp hoặc bản vẽ CAD (Chunk 64KB + SHA-256)">
                                <Path Data="{StaticResource IconPaperclip}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.9"
                                      Width="18" Height="18" Stretch="Uniform" />
                            </Button>

                            <Grid Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ComposerPlaceholder}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextFaintBrush}"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding DraftMessage, Converter={StaticResource InverseStringToVis}}" />
                                <TextBox x:Name="ComposerTextBox"
                                         Text="{Binding DraftMessage, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="13.5"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         CaretBrush="{StaticResource DauRedBrush}"
                                         AcceptsReturn="True"
                                         MaxHeight="96"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         PreviewKeyDown="ComposerTextBox_PreviewKeyDown" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1"
                            Margin="10,0,0,0"
                            Width="46" Height="46"
                            Style="{StaticResource BrandSquareIconButtonStyle}"
                            Command="{Binding SendMessageCommand}"
                            ToolTip="Gửi tin nhắn (Enter)">
                        <Path Data="{StaticResource IconSend}"
                              Stroke="White"
                              StrokeThickness="2"
                              Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                </Grid>
            </Border>

            <!-- Thanh Quản trị phòng chat (Hiển thị riêng cho Admin) -->
            <Border Grid.Row="5"
                    Background="{StaticResource SurfaceWhiteBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,12"
                    Visibility="{Binding IsAdminMode, Converter={StaticResource BoolToVis}}">
                <Grid MaxWidth="820">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource DauRedSoftBrush}">
                            <Path Data="{StaticResource IconShieldCheck}" Stroke="{StaticResource DauRedTextBrush}" StrokeThickness="1.9" Width="15" Height="15" Stretch="Uniform" />
                        </Border>
                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Quản trị Phòng chat" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Quản lý phòng &amp; thành viên" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="33"
                                Padding="9,5"
                                Margin="0,0,6,0"
                                FontSize="12"
                                Content="Sửa phòng"
                                Command="{Binding OpenEditRoomCommand}" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="33"
                                Padding="9,5"
                                Margin="0,0,6,0"
                                FontSize="12"
                                Content="+ Thành viên"
                                Command="{Binding OpenAddMemberCommand}" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="33"
                                Padding="9,5"
                                FontSize="12"
                                Foreground="{StaticResource DangerTextBrush}"
                                Content="Xóa phòng"
                                Command="{Binding DeleteRoomCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- CỘT 3: DRAWER THÔNG TIN PHÒNG -->
        <Border Grid.Column="2"
                Width="296"
                Visibility="{Binding IsInfoDrawerOpen, Converter={StaticResource BoolToVis}}"
                Background="{StaticResource SurfaceWhiteBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="74" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="18,0">
                    <Grid>
                        <TextBlock Text="{Binding InfoHeaderTitle}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding ToggleInfoDrawerCommand}"
                                ToolTip="Đóng bảng thông tin">
                            <Path Data="{StaticResource IconClose}"
                                  Stroke="{StaticResource TextMutedBrush}"
                                  StrokeThickness="2"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Thông tin tổng quan -->
                        <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="18,16">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="58" Height="58" CornerRadius="17"
                                        Background="{Binding SelectedConversation.AvatarBgHex, Converter={StaticResource HexToBrush}, FallbackValue={StaticResource DauRedSoftBrush}}">
                                    <TextBlock Text="{Binding SelectedConversation.Initials, FallbackValue='LT'}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="{Binding SelectedConversation.AvatarFgHex, Converter={StaticResource HexToBrush}, FallbackValue={StaticResource DauRedTextBrush}}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding SelectedConversation.Title}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0" />
                                <TextBlock Text="{Binding SelectedConversation.MetaCaption}"
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,3,0,0" />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding ToggleMuteCommand}" Margin="6,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource SurfaceInputBrush}">
                                                <Path Data="{StaticResource IconBell}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Text="Thông báo" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Button>

                                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding EditPinNoticeCommand}"
                                            Visibility="{Binding CanPinThisRoom, Converter={StaticResource BoolToVis}}"
                                            Margin="6,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource DauRedSoftBrush}">
                                                <Path Data="{StaticResource IconPin}" Stroke="{StaticResource DauRedTextBrush}" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Text="Ghim tin" FontSize="10.5" Foreground="{StaticResource DauRedTextBrush}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Button>

                                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding OpenEditRoomCommand}"
                                            Visibility="{Binding CanEditOrDeleteSelectedRoom, Converter={StaticResource BoolToVis}}"
                                            Margin="6,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource SurfaceInputBrush}">
                                                <Path Data="{StaticResource IconEdit}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Text="Sửa phòng" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Button>

                                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding ToggleMessageSearchCommand}" Margin="6,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource SurfaceInputBrush}">
                                                <Path Data="{StaticResource IconSearch}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Text="Tìm kiếm" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <Button Margin="0,12,0,0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        MinHeight="34"
                                        Padding="12,5"
                                        Background="#FFF8F8"
                                        BorderBrush="{StaticResource DauRedBorderBrush}"
                                        Visibility="{Binding SelectedConversation.HasJoinCode, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                        Command="{Binding CopyRoomJoinCodeCommand}"
                                        ToolTip="Bấm để sao chép mã tham gia lớp / phòng">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Mã tham gia:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding SelectedConversation.RoomJoinCode}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource DauRedTextBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Thành viên phòng -->
                        <Border BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="18,13"
                                Visibility="{Binding SelectedConversation.IsRoom, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="{Binding RoomMembers.Count, StringFormat='Thành viên ({0})'}"
                                               FontSize="12.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                    <Button HorizontalAlignment="Right"
                                            Visibility="{Binding CanManageRooms, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding OpenAddMemberCommand}"
                                            Background="{StaticResource DauRedSoftBrush}"
                                            BorderThickness="0"
                                            Padding="9,5"
                                            Cursor="Hand"
                                            ToolTip="Thêm thành viên vào phòng">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconUserPlus}" Stroke="{StaticResource DauRedTextBrush}" StrokeThickness="2" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                                                        <TextBlock Text="Thêm" Margin="5,0,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DauRedTextBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding RoomMembers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0" Width="32" Height="32" Margin="0,0,10,0">
                                                    <Border CornerRadius="10" Background="{Binding AvatarBgHex, Converter={StaticResource HexToBrush}}">
                                                        <TextBlock Text="{Binding Initials}" FontSize="10" FontWeight="Bold" Foreground="{Binding AvatarFgHex, Converter={StaticResource HexToBrush}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Ellipse Width="9" Height="9"
                                                             Fill="{Binding Presence, Converter={StaticResource PresenceToBrush}}"
                                                             Stroke="White" StrokeThickness="1.5"
                                                             HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FullName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBodyBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Role, Converter={StaticResource RoleDisplay}}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Width="26" Height="26"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Visibility="{Binding CanBeRemoved, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Xóa thành viên khỏi phòng">
                                                    <Path Data="{StaticResource IconUserX}" Stroke="{StaticResource DangerTextBrush}" StrokeThickness="1.8" Width="13" Height="13" Stretch="Uniform" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Tệp đã chia sẻ -->
                        <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="18,13">
                            <StackPanel>
                                <TextBlock Text="Tệp đã chia sẻ" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding RoomSharedFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,0,8"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Margin="0,0,10,0"
                                                            Background="{Binding IconBgHex, Converter={StaticResource HexToBrush}}">
                                                        <Path Data="{StaticResource IconFileText}" Stroke="{Binding IconFgHex, Converter={StaticResource HexToBrush}}" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextBodyBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding SizeAndTimeText}" FontSize="10" Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Chưa có tài liệu chia sẻ trong hội thoại này."
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextFaintBrush}"
                                           Visibility="{Binding RoomSharedFiles.Count, Converter={StaticResource ZeroToVis}}" />
                            </StackPanel>
                        </Border>

                        <!-- Thao tác quản lý Local & Phòng -->
                        <StackPanel Margin="14,10,14,14">
                            <Button Style="{StaticResource DangerGhostButtonStyle}"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Visibility="{Binding CanSendMessages, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DeleteLocalHistoryCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconTrash}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="Xóa lịch sử trên máy" Margin="10,0,0,0" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource DangerGhostButtonStyle}"
                                    Visibility="{Binding CanLeaveSelectedRoom, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding LeaveRoomCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconClose}" Stroke="{StaticResource DangerTextBrush}" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="Rời khỏi phòng" Margin="11,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource DangerTextBrush}" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource DangerGhostButtonStyle}"
                                    Visibility="{Binding CanEditOrDeleteSelectedRoom, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DeleteRoomCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconTrash}" Stroke="{StaticResource DangerTextBrush}" StrokeThickness="1.9" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="Giải tán / Xóa phòng" Margin="11,0,0,0" FontSize="12" FontWeight="Bold" Foreground="{StaticResource DangerTextBrush}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
