<UserControl x:Class="DauChat.Client.UI.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:infra="clr-namespace:DauChat.Client.UI.Infrastructure"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1280"
             Background="Transparent">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="40,32" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="8*" MinWidth="800" MaxWidth="1160" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        MinHeight="540"
                        Background="{StaticResource GlassPanelBrush}"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1.25"
                        CornerRadius="28"
                        Effect="{StaticResource GlassModalShadow}">
                    <Grid>
                        <!-- Ánh sáng lụa chéo & viền kính trong khớp sát đường cong (không lộ mép) -->
                        <Border CornerRadius="27" IsHitTestVisible="False" Background="{StaticResource GlassDiagonalSheenBrush}" />
                        <Border CornerRadius="27" BorderBrush="{StaticResource GlassInnerRimBrush}" BorderThickness="1" IsHitTestVisible="False" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44*" />
                                <ColumnDefinition Width="56*" />
                            </Grid.ColumnDefinitions>

                            <!-- Cột trái: Kính khói Satin Arctic Harbor (co giãn chuẩn tỉ lệ 44%) -->
                            <Border Grid.Column="0"
                                    Background="{StaticResource GlassLoginShowcaseBrush}"
                                    BorderBrush="{StaticResource DarkGlassBorderBrush}"
                                    BorderThickness="0,0,1,0"
                                    CornerRadius="27,0,0,27"
                                    ClipToBounds="True">
                                <Grid>
                                    <!-- Ánh sáng kính chéo + viền vát kính trong + vi tinh thể nhám -->
                                    <Border CornerRadius="27,0,0,27" Background="{StaticResource DarkGlassSheenBrush}" IsHitTestVisible="False" />
                                    <Border CornerRadius="27,0,0,27" BorderBrush="{StaticResource DarkGlassInnerRimBrush}" BorderThickness="1,1,0,1" IsHitTestVisible="False" />
                                    <Border CornerRadius="27,0,0,27" Background="{DynamicResource DarkFrostedGrainBrush}" IsHitTestVisible="False" />
                                    <Rectangle IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <RadialGradientBrush Center="0.92,0.92" GradientOrigin="0.92,0.92" RadiusX="0.72" RadiusY="0.65">
                                                <GradientStop Color="#4C6D001A" Offset="0" />
                                                <GradientStop Color="#1F9E1428" Offset="0.48" />
                                                <GradientStop Color="#006D001A" Offset="1" />
                                            </RadialGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>

                                <Grid Margin="34,34">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Header Logo nổi trên quầng sáng tán xạ (hiệu ứng LogoBloom) -->
                                    <StackPanel Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid Width="72" Height="72" Margin="-8,0,8,0"
                                                  infra:MotionBehavior.Preset="LogoBloom"
                                                  infra:MotionBehavior.DelayMs="60">
                                                <Ellipse Fill="{StaticResource LogoSpotlightHaloBrush}" />
                                                <Image Source="pack://application:,,,/Assets/dau-logo.png"
                                                       Width="46"
                                                       Height="46"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                            <StackPanel VerticalAlignment="Center"
                                                        infra:MotionBehavior.Preset="StaggerItem"
                                                        infra:MotionBehavior.DelayMs="80">
                                                <TextBlock Text="ĐẠI HỌC KIẾN TRÚC ĐÀ NẴNG"
                                                           FontSize="9.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrandSlateIceBrush}" />
                                                <TextBlock Text="DAU Chat"
                                                           FontSize="25"
                                                           FontWeight="Bold"
                                                           Foreground="#F5FAFC"
                                                           Margin="0,1,0,0" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Dải chuyển màu Harbor → Burgundy tự vẽ từ trái sang phải (DrawLineX) -->
                                        <Border Width="76"
                                                Height="3"
                                                CornerRadius="2"
                                                HorizontalAlignment="Left"
                                                Background="{StaticResource HarborToBurgundyBarBrush}"
                                                infra:MotionBehavior.Preset="DrawLineX"
                                                infra:MotionBehavior.DelayMs="140"
                                                Margin="2,18,0,0" />

                                        <TextBlock Text="Không gian trao đổi học thuật và chuyển giao bản vẽ nội bộ theo kiến trúc Local-First."
                                                   Margin="2,14,0,0"
                                                   FontSize="13"
                                                   LineHeight="21"
                                                   Foreground="#CBD9E3"
                                                   infra:MotionBehavior.Preset="StaggerItem"
                                                   infra:MotionBehavior.DelayMs="120"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- 3 Thẻ kính nhám tối xuất hiện theo nhịp phân tầng (Stagger Choreography) -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,24,0,22">
                                        <Border Background="{StaticResource DarkCardGlassBrush}"
                                                BorderBrush="{StaticResource DarkCardGlassBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="16"
                                                Padding="14,13"
                                                Margin="0,0,0,10"
                                                infra:MotionBehavior.Preset="StaggerItem"
                                                infra:MotionBehavior.DelayMs="150">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#22E8EFF3" BorderBrush="#48A9BDC9" BorderThickness="1" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconShieldCheck}"
                                                          Stroke="#E8EFF3"
                                                          StrokeThickness="1.8"
                                                          Width="15" Height="15" Stretch="Uniform"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Lưu trữ Local-First trên máy trạm" FontSize="12.5" FontWeight="SemiBold" Foreground="#F5FAFC" TextWrapping="Wrap" />
                                                    <TextBlock Text="Lịch sử .jsonl tách biệt an toàn theo UserId" FontSize="11" Foreground="#A9BDC9" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Background="{StaticResource DarkCardGlassBrush}"
                                                BorderBrush="{StaticResource DarkCardGlassBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="16"
                                                Padding="14,13"
                                                Margin="0,0,0,10"
                                                infra:MotionBehavior.Preset="StaggerItem"
                                                infra:MotionBehavior.DelayMs="220">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#369E1428" BorderBrush="#5CE39AA6" BorderThickness="1" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconServer}"
                                                          Stroke="#F7C2CB"
                                                          StrokeThickness="1.8"
                                                          Width="15" Height="15" Stretch="Uniform"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Truyền tệp Chunk 64KB + SHA-256" FontSize="12.5" FontWeight="SemiBold" Foreground="#F5FAFC" TextWrapping="Wrap" />
                                                    <TextBlock Text="Đóng gói TCP Length-prefix 4 byte qua cổng 9050" FontSize="11" Foreground="#A9BDC9" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Background="{StaticResource DarkCardGlassBrush}"
                                                BorderBrush="{StaticResource DarkCardGlassBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="16"
                                                Padding="14,13"
                                                infra:MotionBehavior.Preset="StaggerItem"
                                                infra:MotionBehavior.DelayMs="290">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#280E9672" BorderBrush="#527CE3C4" BorderThickness="1" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconLock}"
                                                          Stroke="#8AE9CD"
                                                          StrokeThickness="1.8"
                                                          Width="15" Height="15" Stretch="Uniform"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Cấp phát nội bộ • Phân quyền RBAC" FontSize="12.5" FontWeight="SemiBold" Foreground="#F5FAFC" TextWrapping="Wrap" />
                                                    <TextBlock Text="Quản trị viên / Giảng viên / Sinh viên DAU" FontSize="11" Foreground="#A9BDC9" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- Footer Pill tối giản (phong cách Ảnh 3) -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#1CE8EFF3"
                                                BorderBrush="#3DA9BDC9"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="10,4">
                                            <TextBlock Text="TEAM 5 • .NET 10 WPF"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="#DCE8F0" />
                                        </Border>
                                        <TextBlock Text="Mạng nội bộ DAU"
                                                   Margin="10,0,0,0"
                                                   FontSize="11"
                                                   Foreground="#8EA8BC"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Cột phải: Form Đăng nhập trên nền Trắng Băng Sứ Kính Nhám -->
                        <Grid Grid.Column="1" Margin="44,44" VerticalAlignment="Center"
                              infra:MotionBehavior.Preset="SlideUpFade"
                              infra:MotionBehavior.DelayMs="110"
                              infra:MotionBehavior.DurationMs="520">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <StackPanel Grid.Row="0">
                                <Border HorizontalAlignment="Left"
                                        Background="{StaticResource BrandSlateSoftBrush}"
                                        BorderBrush="{StaticResource BrandSlateBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="9,3"
                                        Margin="0,0,0,10">
                                    <TextBlock Text="XÁC THỰC NỘI BỘ"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrandSlateTextBrush}" />
                                </Border>
                                <TextBlock Text="Đăng nhập tài khoản DAU"
                                           FontSize="25"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Nhập mã tài khoản được cấp và kiểm tra máy chủ TCP nội bộ."
                                           FontSize="13"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <!-- Inputs -->
                            <StackPanel Grid.Row="1" Margin="0,26,0,0">
                                <TextBlock Text="Mã tài khoản / Mã sinh viên" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Margin="0,7,0,0"
                                         MinHeight="44"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Mật khẩu" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,18,0,0" />
                                <PasswordBox x:Name="LoginPasswordBox"
                                             Margin="0,7,0,0"
                                             MinHeight="44"
                                             Style="{StaticResource ModernPasswordBoxStyle}"
                                             PasswordChanged="LoginPasswordBox_PasswordChanged"
                                             KeyDown="LoginInput_KeyDown" />

                                <!-- Ghi nhớ & Mở cấu hình TCP -->
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              Margin="0,0,10,0"
                                              Content="Ghi nhớ mã tài khoản trên máy này"
                                              IsChecked="{Binding RememberUsername}"
                                              FontFamily="{StaticResource PrimaryFont}"
                                              FontSize="12"
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              VerticalAlignment="Center" />

                                    <Button Grid.Column="1"
                                            Style="{StaticResource InlineGlassLinkButtonStyle}"
                                            Command="{Binding ToggleServerConfigCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconServer}"
                                                  Stroke="{StaticResource BrandSlateTextBrush}"
                                                  StrokeThickness="2"
                                                  Width="13" Height="13" Stretch="Uniform"
                                                  VerticalAlignment="Center" />
                                            <TextBlock Text="Máy chủ TCP"
                                                       Margin="6,0,0,0"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrandSlateTextBrush}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Cấu hình máy chủ TCP thu gọn (Enter + Exit mượt) -->
                                <Border infra:MotionBehavior.IsShown="{Binding ShowServerConfig}"
                                        infra:MotionBehavior.Preset="SlideDownFade"
                                        Margin="0,14,0,0"
                                        Background="#C8F4F8FA"
                                        BorderBrush="{StaticResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Địa chỉ IP Máy chủ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBox Margin="0,5,0,0"
                                                     Style="{StaticResource ModernTextBoxStyle}"
                                                     MinHeight="38"
                                                     Padding="10,7"
                                                     Text="{Binding ServerHost, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Cổng TCP" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBox Margin="0,5,0,0"
                                                     Style="{StaticResource ModernTextBoxStyle}"
                                                     MinHeight="38"
                                                     Padding="10,7"
                                                     Text="{Binding ServerPortText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Thông báo lỗi đăng nhập / khóa tài khoản -->
                                <Border Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}"
                                        infra:MotionBehavior.Preset="SlideDownFade"
                                        Margin="0,16,0,0"
                                        Background="{StaticResource DauRedSoftBrush}"
                                        BorderBrush="{StaticResource DauRedBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="13"
                                        Padding="12,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconAlert}"
                                              Stroke="{StaticResource DauRedTextBrush}"
                                              StrokeThickness="2"
                                              Width="16" Height="16" Stretch="Uniform"
                                              VerticalAlignment="Top" Margin="0,2,10,0" />
                                        <TextBlock Text="{Binding ErrorMessage}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource DauRedSelectedTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Button Margin="0,22,0,0"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        MinHeight="48"
                                        Command="{Binding LoginCommand}"
                                        Content="{Binding LoginButtonText}" />

                                <TextBlock Text="Chưa có tài khoản hoặc quên mật khẩu? Liên hệ Quản trị viên DAU để cấp tài khoản mới hoặc đặt lại mật khẩu mặc định."
                                           Margin="0,14,0,0"
                                           FontSize="11.5"
                                           LineHeight="17"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
