<UserControl x:Class="DauChat.Client.UI.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1280"
             Background="{StaticResource CanvasBgBrush}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MinHeight="680" Margin="32">
                <Border MaxWidth="980"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource SurfaceWhiteBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="24">
                    <Border.Effect>
                        <DropShadowEffect Color="#0F172A" Opacity="0.06" BlurRadius="32" ShadowDepth="8" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Cột trái: Nhận diện DAU & Kiến trúc hệ thống -->
                        <Border Grid.Column="0"
                                Background="{StaticResource DauRedSoftBrush}"
                                BorderBrush="{StaticResource DauRedBorderBrush}"
                                BorderThickness="0,0,1,0"
                                CornerRadius="24,0,0,24"
                                Padding="32,36">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="White"
                                                CornerRadius="16"
                                                Padding="8"
                                                BorderBrush="{StaticResource DauRedBorderBrush}"
                                                BorderThickness="1">
                                            <Image Source="pack://application:,,,/Assets/dau-logo.png"
                                                   Width="44"
                                                   Height="44"
                                                   Stretch="Uniform" />
                                        </Border>
                                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="ĐẠI HỌC KIẾN TRÚC ĐÀ NẴNG"
                                                       FontSize="10.5"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource DauRedTextBrush}" />
                                            <TextBlock Text="DAU Chat"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="Không gian trao đổi học thuật và chuyển giao bản vẽ nội bộ theo kiến trúc Local-First."
                                               Margin="0,24,0,0"
                                               FontSize="13.5"
                                               LineHeight="21"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,28,0,24">
                                    <Border Background="White"
                                            BorderBrush="{StaticResource DauRedBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="14"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10" Background="{StaticResource DauRedSoftBrush}" VerticalAlignment="Top">
                                                <Path Data="{StaticResource IconShieldCheck}"
                                                      Stroke="{StaticResource DauRedTextBrush}"
                                                      StrokeThickness="2"
                                                      Width="17" Height="17" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="Lưu trữ Local-First trên thiết bị" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="Lịch sử .jsonl tách riêng theo từng UserId" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Background="White"
                                            BorderBrush="{StaticResource DauRedBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="14"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10" Background="{StaticResource BlueSoftBrush}" VerticalAlignment="Top">
                                                <Path Data="{StaticResource IconServer}"
                                                      Stroke="{StaticResource BlueBrush}"
                                                      StrokeThickness="2"
                                                      Width="17" Height="17" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="Truyền tệp Chunk 64KB + SHA-256" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="Đóng gói TCP Length-prefix 4 byte qua cổng 9050" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Background="White"
                                            BorderBrush="{StaticResource DauRedBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10" Background="{StaticResource EmeraldSoftBrush}" VerticalAlignment="Top">
                                                <Path Data="{StaticResource IconLock}"
                                                      Stroke="{StaticResource EmeraldTextBrush}"
                                                      StrokeThickness="2"
                                                      Width="17" Height="17" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="Cấp phát nội bộ • Phân quyền RBAC" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="Admin / Giảng viên / Sinh viên (không tự đăng ký)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <TextBlock Grid.Row="2"
                                           Text="Team 5 • Đồ án Lập trình mạng (.NET 10.0 WPF)"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource DauRedTextBrush}" />
                            </Grid>
                        </Border>

                        <!-- Cột phải: Form Đăng nhập & Chọn nhanh Demo -->
                        <Grid Grid.Column="1" Margin="38,34">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="XÁC THỰC NỘI BỘ"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource DauRedTextBrush}" />
                                <TextBlock Text="Đăng nhập tài khoản DAU"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="Nhập mã tài khoản được cấp và kiểm tra máy chủ TCP nội bộ."
                                           FontSize="13"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <!-- Inputs -->
                            <StackPanel Grid.Row="1" Margin="0,24,0,0">
                                <TextBlock Text="Mã tài khoản / Mã sinh viên" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Margin="0,7,0,0"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Mật khẩu" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,0" />
                                <PasswordBox x:Name="LoginPasswordBox"
                                             Margin="0,7,0,0"
                                             Style="{StaticResource ModernPasswordBoxStyle}"
                                             PasswordChanged="LoginPasswordBox_PasswordChanged"
                                             KeyDown="LoginInput_KeyDown" />

                                <!-- Ghi nhớ & Mở cấu hình TCP -->
                                <Grid Margin="0,14,0,0">
                                    <CheckBox Content="Ghi nhớ mã tài khoản trên máy này"
                                              IsChecked="{Binding RememberUsername}"
                                              FontFamily="{StaticResource PrimaryFont}"
                                              FontSize="12"
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              VerticalAlignment="Center" />

                                    <Button HorizontalAlignment="Right"
                                            Command="{Binding ToggleServerConfigCommand}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Padding="4,2">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconServer}"
                                                  Stroke="{StaticResource DauRedTextBrush}"
                                                  StrokeThickness="2"
                                                  Width="13" Height="13" Stretch="Uniform"
                                                  VerticalAlignment="Center" />
                                            <TextBlock Text="Máy chủ TCP"
                                                       Margin="6,0,0,0"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource DauRedTextBrush}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Cấu hình máy chủ TCP thu gọn -->
                                <Border Visibility="{Binding ShowServerConfig, Converter={StaticResource BoolToVis}}"
                                        Margin="0,12,0,0"
                                        Background="{StaticResource SurfaceSubtleBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Địa chỉ IP Máy chủ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBox Margin="0,5,0,0"
                                                     Style="{StaticResource ModernTextBoxStyle}"
                                                     MinHeight="36"
                                                     Padding="10,7"
                                                     Text="{Binding ServerHost, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Cổng TCP" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBox Margin="0,5,0,0"
                                                     Style="{StaticResource ModernTextBoxStyle}"
                                                     MinHeight="36"
                                                     Padding="10,7"
                                                     Text="{Binding ServerPortText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Thông báo lỗi đăng nhập / khóa tài khoản -->
                                <Border Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}"
                                        Margin="0,14,0,0"
                                        Background="{StaticResource DauRedSoftBrush}"
                                        BorderBrush="{StaticResource DauRedBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="12,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconAlert}"
                                              Stroke="{StaticResource DauRedTextBrush}"
                                              StrokeThickness="2"
                                              Width="16" Height="16" Stretch="Uniform"
                                              VerticalAlignment="Top" Margin="0,2,10,0" />
                                        <TextBlock Text="{Binding ErrorMessage}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource DauRedSelectedTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Button Margin="0,18,0,0"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        MinHeight="46"
                                        Command="{Binding LoginCommand}"
                                        Content="{Binding LoginButtonText}" />

                                <TextBlock Text="Chưa có tài khoản hoặc quên mật khẩu? Liên hệ Quản trị viên DAU để cấp tài khoản mới hoặc đặt lại mật khẩu mặc định."
                                           Margin="0,12,0,0"
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Chọn nhanh tài khoản Demo mẫu đồ án -->
                            <Border Grid.Row="2"
                                    Margin="0,22,0,0"
                                    Background="{StaticResource SurfaceSubtleBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="DỮ LIỆU DEMO ĐỒ ÁN (MẬT KHẨU: 123456)"
                                                   FontSize="10.5"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <Button HorizontalAlignment="Right"
                                                Command="{Binding LaunchThreeRolesCommand}"
                                                Cursor="Hand"
                                                Background="{StaticResource DauRedSoftBrush}"
                                                BorderBrush="{StaticResource DauRedBorderBrush}"
                                                BorderThickness="1"
                                                Padding="9,4"
                                                ToolTip="Mở đồng thời 3 cửa sổ Sinh viên, Giảng viên và Admin để test phân quyền">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="8"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <TextBlock Text="Mở 3 cửa sổ test (SV / GV / Admin)"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource DauRedTextBrush}" />
                                        </Button>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding DemoAccounts}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="3"
                                                        Padding="10,8"
                                                        Cursor="Hand"
                                                        Background="White"
                                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                                        BorderThickness="1"
                                                        HorizontalContentAlignment="Stretch"
                                                        Command="{Binding DataContext.SelectDemoAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Card"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="10"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource DauRedBorderBrush}" />
                                                                    <Setter TargetName="Card" Property="Background" Value="{StaticResource DauRedSoftBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0">
                                                            <TextBlock Text="{Binding Username}"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                                            <Border HorizontalAlignment="Right"
                                                                    CornerRadius="6"
                                                                    Padding="6,2"
                                                                    Background="{Binding BadgeBgHex, Converter={StaticResource HexToBrush}}">
                                                                <TextBlock Text="{Binding RoleTag}"
                                                                           FontSize="9.5"
                                                                           FontWeight="Bold"
                                                                           Foreground="{Binding BadgeFgHex, Converter={StaticResource HexToBrush}}" />
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Grid.Row="1"
                                                                   Margin="0,3,0,0"
                                                                   Text="{Binding Note}"
                                                                   FontSize="10.5"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
