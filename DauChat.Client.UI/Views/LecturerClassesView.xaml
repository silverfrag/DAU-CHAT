<UserControl x:Class="DauChat.Client.UI.Views.LecturerClassesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1180"
             Background="{StaticResource CanvasBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="74" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceWhiteBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="28,0">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GIẢNG VIÊN • QUẢN LÝ LỚP HỌC PHẦN"
                               FontSize="10.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource DauRedTextBrush}" />
                    <TextBlock Text="Lớp học &amp; Sinh viên"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Width="250" Height="38" Background="{StaticResource SurfaceInputBrush}" CornerRadius="10" Padding="12,0" Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconSearch}" Stroke="{StaticResource TextFaintBrush}" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                            <Grid Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Tìm mã lớp, môn hoặc mã tham gia..." FontSize="12" Foreground="{StaticResource TextFaintBrush}" IsHitTestVisible="False"
                                           Visibility="{Binding SearchQuery, Converter={StaticResource InverseStringToVis}}" />
                                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="12.5" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            MinHeight="38"
                            Padding="16,8"
                            Command="{Binding OpenCreateClassCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Stroke="White" StrokeThickness="2.2" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="Tạo lớp học phần" Margin="8,0,0,0" FontSize="12.5" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Master-Detail Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: DANH SÁCH LỚP CỦA GIẢNG VIÊN -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceWhiteBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,16,20,10">
                        <TextBlock Text="{Binding TotalClassesCount, StringFormat='Lớp đang phụ trách ({0})'}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource IconButtonStyle}"
                                Width="30" Height="30"
                                Command="{Binding RefreshCommand}"
                                ToolTip="Làm mới danh sách lớp">
                            <Path Data="{StaticResource IconRefresh}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.9" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,0,10,16">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding FilteredClasses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,0,6"
                                                Command="{Binding DataContext.SelectClassCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="RowCard"
                                                            CornerRadius="14"
                                                            Padding="14,12"
                                                            BorderThickness="1"
                                                            BorderBrush="Transparent"
                                                            Background="Transparent">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RowCard" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="RowCard" Property="Background" Value="{StaticResource DauRedSoftBrush}" />
                                                            <Setter TargetName="RowCard" Property="BorderBrush" Value="{StaticResource DauRedBorderBrush}" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>

                                            <StackPanel>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="{StaticResource SurfaceInputBrush}" CornerRadius="7" Padding="7,3">
                                                            <TextBlock Text="{Binding ClassCode}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DauRedTextBrush}" />
                                                        </Border>
                                                        <Border Margin="6,0,0,0" Background="#ECFDF5" CornerRadius="7" Padding="7,3"
                                                                Visibility="{Binding HasLinkedRoom, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Có phòng chat" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource EmeraldTextBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding MemberCount, StringFormat='{}{0} TV'}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                </Grid>

                                                <TextBlock Text="{Binding ClassName}"
                                                           FontSize="13.5"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,8,0,0" />

                                                <Grid Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding Department}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,0,85,0" />
                                                    <Border HorizontalAlignment="Right" Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2">
                                                        <TextBlock Text="{Binding JoinCode}" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Chưa có lớp học nào khớp bộ lọc."
                                       Margin="12,32"
                                       HorizontalAlignment="Center"
                                       FontSize="12.5"
                                       Foreground="{StaticResource TextFaintBrush}"
                                       Visibility="{Binding FilteredClasses.Count, Converter={StaticResource ZeroToVis}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- CỘT PHẢI: MÃ THAM GIA & DANH SÁCH SINH VIÊN -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="26,22,26,36" MaxWidth="920">
                    <!-- Empty State -->
                    <Border Style="{StaticResource CardBorderStyle}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="36"
                            Visibility="{Binding HasSelectedClass, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="360">
                            <Border Width="52" Height="52" CornerRadius="16" Background="{StaticResource DauRedSoftBrush}" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconGraduationCap}" Stroke="{StaticResource DauRedTextBrush}" StrokeThickness="1.9" Width="24" Height="24" Stretch="Uniform" />
                            </Border>
                            <TextBlock Text="Chọn hoặc tạo lớp học phần mới" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                            <TextBlock Text="Giảng viên có thể tạo mã lớp giống Google Classroom hoặc thêm nhanh danh sách sinh viên qua CheckBox / CSV."
                                       FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,18" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" Content="+ Tạo lớp học phần" Command="{Binding OpenCreateClassCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Detail Content -->
                    <StackPanel Visibility="{Binding HasSelectedClass, Converter={StaticResource BoolToVis}}">
                        <!-- Card 1: Header thông tin lớp -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{StaticResource DauRedSoftBrush}" CornerRadius="8" Padding="9,4">
                                            <TextBlock Text="{Binding SelectedClass.ClassCode}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource DauRedTextBrush}" />
                                        </Border>
                                        <Border Margin="8,0,0,0" Background="{StaticResource SurfaceInputBrush}" CornerRadius="8" Padding="9,4">
                                            <TextBlock Text="{Binding SelectedClass.AcademicYear}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                        <Border Margin="8,0,0,0" Background="{StaticResource EmeraldSoftBrush}" CornerRadius="8" Padding="9,4"
                                                Visibility="{Binding SelectedClass.HasLinkedRoom, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Phòng chat đã đồng bộ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource EmeraldTextBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding SelectedClass.ClassName}"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,10,0,0" />

                                    <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0">
                                        <Run Text="{Binding SelectedClass.Department, Mode=OneWay}" />
                                        <Run Text=" • " />
                                        <Run Text="{Binding SelectedClass.MemberCount, StringFormat='{}{0} thành viên đang học', Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            MinHeight="36"
                                            Padding="12,6"
                                            Margin="0,0,8,0"
                                            Command="{Binding OpenEditClassCommand}"
                                            ToolTip="Sửa thông tin lớp học">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconEdit}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.9" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                            <TextBlock Text="Sửa" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            MinHeight="36"
                                            Padding="14,6"
                                            Margin="0,0,8,0"
                                            Background="{StaticResource EmeraldSoftBrush}"
                                            BorderBrush="#A7F3D0"
                                            Foreground="{StaticResource EmeraldTextBrush}"
                                            Command="{Binding OpenOrSyncLinkedRoomCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconMessage}" Stroke="{StaticResource EmeraldTextBrush}" StrokeThickness="1.9" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding LinkedRoomActionLabel}" Margin="7,0,0,0" FontSize="12" FontWeight="Bold" Foreground="{StaticResource EmeraldTextBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Width="36" Height="36"
                                            Style="{StaticResource IconButtonStyle}"
                                            Command="{Binding DeleteClassCommand}"
                                            ToolTip="Xóa lớp học phần">
                                        <Path Data="{StaticResource IconTrash}" Stroke="{StaticResource DangerTextBrush}" StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 2: Thẻ Mã Lớp kiểu Google Classroom -->
                        <Border Background="#FFF8F8"
                                BorderBrush="{StaticResource DauRedBorderBrush}"
                                BorderThickness="1.2"
                                CornerRadius="16"
                                Padding="22"
                                Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconHash}" Stroke="{StaticResource DauRedTextBrush}" StrokeThickness="2.2" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                        <TextBlock Text="MÃ THAM GIA LỚP HỌC (KIỂU GOOGLE CLASSROOM)"
                                                   Margin="6,0,0,0"
                                                   FontSize="10.5"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource DauRedTextBrush}" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding SelectedClass.JoinCode}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource DauRedBrush}"
                                               Margin="0,8,0,0" />

                                    <TextBlock Text="Cung cấp mã này cho sinh viên nhập tại mục 'Tham gia bằng mã lớp' để tự động tham gia lớp và đồng bộ vào phòng chat."
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="215">
                                    <Grid Margin="0,0,0,10">
                                        <Button HorizontalAlignment="Left"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                MinHeight="36"
                                                Padding="14,6"
                                                Command="{Binding CopyJoinCodeCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconCopy}" Stroke="White" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                                <TextBlock Text="Sao chép mã" Margin="7,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                            </StackPanel>
                                        </Button>

                                        <Button HorizontalAlignment="Right"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                MinHeight="36"
                                                Padding="12,6"
                                                Command="{Binding RegenerateJoinCodeCommand}"
                                                ToolTip="Tạo mã tham gia mới (mã cũ sẽ hết hiệu lực)">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconRefresh}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                                <TextBlock Text="Đổi mã" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Border Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8">
                                        <Grid>
                                            <TextBlock Text="Cho phép SV nhập mã" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <CheckBox HorizontalAlignment="Right"
                                                      Style="{StaticResource ModernToggleSwitchStyle}"
                                                      IsChecked="{Binding AllowStudentJoinByCode, Mode=OneWay}"
                                                      Command="{Binding ToggleAllowJoinCodeCommand}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 3: Danh sách sinh viên & Thêm hàng loạt -->
                        <Border Background="{StaticResource SurfaceWhiteBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="16">
                            <StackPanel>
                                <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="20,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="Danh sách thành viên lớp" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="Thành viên được đồng bộ hai chiều với phòng chat của lớp học phần" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Border Width="156" Height="36" Background="{StaticResource SurfaceInputBrush}" CornerRadius="9" Padding="10,0" Margin="0,0,8,0">
                                                <Grid>
                                                    <TextBlock Text="Tìm sinh viên / MSSV..." FontSize="11.5" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" IsHitTestVisible="False"
                                                               Visibility="{Binding MemberSearchQuery, Converter={StaticResource InverseStringToVis}}" />
                                                    <TextBox Text="{Binding MemberSearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" FontSize="12" VerticalContentAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    MinHeight="36"
                                                    Padding="11,7"
                                                    Margin="0,0,8,0"
                                                    Command="{Binding ExportMembersCsvCommand}"
                                                    ToolTip="Xuất danh sách thành viên lớp ra tệp Excel (.csv)">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconDownload}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.9" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                                    <TextBlock Text="Xuất CSV" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>

                                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                                    MinHeight="36"
                                                    Padding="13,7"
                                                    Command="{Binding OpenBulkAddMembersCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconUserPlus}" Stroke="White" StrokeThickness="2" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                                    <TextBlock Text="Thêm danh sách SV" Margin="7,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding FilteredMembers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="20,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0">
                                                        <Border CornerRadius="11" Background="{Binding AvatarBgHex, Converter={StaticResource HexToBrush}}">
                                                            <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="Bold" Foreground="{Binding AvatarFgHex, Converter={StaticResource HexToBrush}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Ellipse Width="9" Height="9" Fill="{Binding Presence, Converter={StaticResource PresenceToBrush}}" Stroke="White" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                    </Grid>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding FullName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Username}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="7" Padding="8,4" Margin="0,0,12,0"
                                                            Background="{Binding RoleBadgeBgHex, Converter={StaticResource HexToBrush}}">
                                                        <TextBlock Text="{Binding Role, Converter={StaticResource RoleDisplay}}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding RoleBadgeFgHex, Converter={StaticResource HexToBrush}}" />
                                                    </Border>

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Width="78" Margin="0,0,8,0">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding Presence, Converter={StaticResource PresenceToBrush}}" VerticalAlignment="Center" />
                                                        <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Offline" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                            <Setter Property="Text" Value="Online" />
                                                                            <Setter Property="Foreground" Value="{StaticResource EmeraldTextBrush}" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <Button Grid.Column="4"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            MinHeight="30"
                                                            Padding="10,4"
                                                            FontSize="11"
                                                            Foreground="{StaticResource DangerTextBrush}"
                                                            Content="Xóa khỏi lớp"
                                                            Visibility="{Binding CanBeRemoved, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Chưa có thành viên nào trong danh sách."
                                           Margin="20,24"
                                           HorizontalAlignment="Center"
                                           FontSize="12.5"
                                           Foreground="{StaticResource TextFaintBrush}"
                                           Visibility="{Binding FilteredMembers.Count, Converter={StaticResource ZeroToVis}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

