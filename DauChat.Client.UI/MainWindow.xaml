            <TextBlock Text="DAU CHAT - ĐẠI HỌC KIẾN TRÚC ĐÀ NẴNG"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#1E3A8A"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Khung giao diện WPF (.NET 10.0 LTS) - TV1 Leader (Team 5)"
                       FontSize="14"
                       Foreground="#475569"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
