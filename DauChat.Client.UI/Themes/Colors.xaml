<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Thương hiệu Đại học Kiến trúc Đà Nẵng (DAU Brand Red) -->
    <Color x:Key="DauRedColor">#CB0914</Color>
    <Color x:Key="DauRedHoverColor">#A90811</Color>
    <Color x:Key="DauRedPressedColor">#8E060E</Color>
    <Color x:Key="DauRedTextColor">#C41313</Color>
    <Color x:Key="DauRedSelectedTextColor">#9F0A12</Color>
    <Color x:Key="DauRedSoftColor">#FFF1F1</Color>
    <Color x:Key="DauRedTintColor">#FEF2F2</Color>
    <Color x:Key="DauRedBorderColor">#FECACA</Color>

    <!-- Nền & Bề mặt (Crisp Light Minimal Surface) -->
    <Color x:Key="CanvasBgColor">#F7F8FA</Color>
    <Color x:Key="SurfaceWhiteColor">#FFFFFF</Color>
    <Color x:Key="SurfaceSubtleColor">#F8FAFC</Color>
    <Color x:Key="SurfaceInputColor">#F1F5F9</Color>
    <Color x:Key="SurfaceHoverColor">#F8FAFC</Color>

    <!-- Đường viền & Chia tách -->
    <Color x:Key="BorderSubtleColor">#E2E8F0</Color>
    <Color x:Key="BorderLightColor">#F1F5F9</Color>
    <Color x:Key="BorderStrongColor">#CBD5E1</Color>

    <!-- Chữ (Ink Typography) -->
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextBodyColor">#1E293B</Color>
    <Color x:Key="TextSecondaryColor">#475569</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>
    <Color x:Key="TextFaintColor">#94A3B8</Color>

    <!-- Trạng thái & Ngữ nghĩa -->
    <Color x:Key="EmeraldColor">#10B981</Color>
    <Color x:Key="EmeraldTextColor">#047857</Color>
    <Color x:Key="EmeraldSoftColor">#ECFDF5</Color>
    <Color x:Key="BlueColor">#2563EB</Color>
    <Color x:Key="BlueSoftColor">#EFF6FF</Color>
    <Color x:Key="AmberColor">#D97706</Color>
    <Color x:Key="AmberSoftColor">#FFFBEB</Color>
    <Color x:Key="VioletColor">#7C3AED</Color>
    <Color x:Key="VioletSoftColor">#F5F3FF</Color>
    <Color x:Key="DangerTextColor">#DC2626</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="DauRedBrush" Color="{StaticResource DauRedColor}" />
    <SolidColorBrush x:Key="DauRedHoverBrush" Color="{StaticResource DauRedHoverColor}" />
    <SolidColorBrush x:Key="DauRedPressedBrush" Color="{StaticResource DauRedPressedColor}" />
    <SolidColorBrush x:Key="DauRedTextBrush" Color="{StaticResource DauRedTextColor}" />
    <SolidColorBrush x:Key="DauRedSelectedTextBrush" Color="{StaticResource DauRedSelectedTextColor}" />
    <SolidColorBrush x:Key="DauRedSoftBrush" Color="{StaticResource DauRedSoftColor}" />
    <SolidColorBrush x:Key="DauRedTintBrush" Color="{StaticResource DauRedTintColor}" />
    <SolidColorBrush x:Key="DauRedBorderBrush" Color="{StaticResource DauRedBorderColor}" />

    <SolidColorBrush x:Key="CanvasBgBrush" Color="{StaticResource CanvasBgColor}" />
    <SolidColorBrush x:Key="SurfaceWhiteBrush" Color="{StaticResource SurfaceWhiteColor}" />
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="{StaticResource SurfaceSubtleColor}" />
    <SolidColorBrush x:Key="SurfaceInputBrush" Color="{StaticResource SurfaceInputColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextBodyBrush" Color="{StaticResource TextBodyColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}" />

    <SolidColorBrush x:Key="EmeraldBrush" Color="{StaticResource EmeraldColor}" />
    <SolidColorBrush x:Key="EmeraldTextBrush" Color="{StaticResource EmeraldTextColor}" />
    <SolidColorBrush x:Key="EmeraldSoftBrush" Color="{StaticResource EmeraldSoftColor}" />
    <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueColor}" />
    <SolidColorBrush x:Key="BlueSoftBrush" Color="{StaticResource BlueSoftColor}" />
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="AmberSoftBrush" Color="{StaticResource AmberSoftColor}" />
    <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource VioletColor}" />
    <SolidColorBrush x:Key="VioletSoftBrush" Color="{StaticResource VioletSoftColor}" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="{StaticResource DangerTextColor}" />

    <SolidColorBrush x:Key="ModalBackdropBrush" Color="#660F172A" />
    <SolidColorBrush x:Key="DarkAvatarBrush" Color="#1F2937" />

    <!-- Font Family chuẩn tiếng Việt -->
    <FontFamily x:Key="PrimaryFont">Be Vietnam Pro, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>

</ResourceDictionary>

