                                        <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.20" />
                                        <DoubleAnimation Storyboard.TargetName="PillTrans" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.20" />
