<Application x:Class="DauChat.Client.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DauChat.Client.UI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
            <conv:NullToVisibilityConverter x:Key="InverseNullToVis" Invert="True" />
            <conv:StringNotEmptyToVisibilityConverter x:Key="StringToVis" />
            <conv:StringNotEmptyToVisibilityConverter x:Key="InverseStringToVis" Invert="True" />
            <conv:CountZeroToVisibilityConverter x:Key="ZeroToVis" VisibleWhenZero="True" />
            <conv:CountZeroToVisibilityConverter x:Key="NotZeroToVis" VisibleWhenZero="False" />
            <conv:HexToBrushConverter x:Key="HexToBrush" />
            <conv:PresenceToBrushConverter x:Key="PresenceToBrush" />
            <conv:RoleToDisplayConverter x:Key="RoleDisplay" />
            <conv:AccountStatusToDisplayConverter x:Key="AccountStatusDisplay" />
            <conv:RoomTypeToDisplayConverter x:Key="RoomTypeDisplay" />
            <conv:EnumEqualsConverter x:Key="EnumEquals" />
            <conv:EnumEqualsToVisibilityConverter x:Key="EnumEqualsToVis" />
            <conv:PercentWidthConverter x:Key="PercentWidth" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
